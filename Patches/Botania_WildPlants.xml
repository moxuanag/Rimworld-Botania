<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- ============================================================
       野生神秘花：8 色**全部自然生成**，每色权重 0.01，
       单群系合计 0.08，约 0.16 个原版蒲公英（蒲公英 0.5）。
       只挂在能长花的生物群系上：温带/寒带/热带森林、沼泽、灌木荒原、
       沙漠、冷沼、苔原。冰盖、极端沙漠、地下、海洋不长。

       播种口径：野生 8 色**都不能播种**（均无 sowTags）；
       只有研究「神秘花卉」后的高产白花 Botania_MysticFlower_WhiteGarden 可播种。
       产出：野生花每株采 1 片花瓣；彩瓣也可用「4 白瓣 + 2 染料」在花药台染出。

       密度沿革（同群系原版参照：蒲公英 0.5、野浆果 0.05、草 5.0）：
         0.5.0：8 色 × 0.08 = 0.64，约 1.3 个蒲公英；
         0.6.0：减半 → 8 色 × 0.04 = 0.32，约 0.64 个蒲公英；
         0.9.2：野外只保留白花 0.02，其余 7 色改为「白瓣 + 染料」染色获得；
         本次：8 色各 0.01，合计 0.08，约 0.16 个蒲公英。
       ============================================================ -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/BiomeDef[defName="TemperateForest" or defName="BorealForest" or defName="TropicalRainforest" or defName="TemperateSwamp" or defName="TropicalSwamp" or defName="AridShrubland" or defName="Desert" or defName="ColdBog" or defName="Tundra"]/wildPlants</xpath>
    <value>
        <Botania_MysticFlower_White>0.01</Botania_MysticFlower_White>
        <Botania_MysticFlower_Orange>0.01</Botania_MysticFlower_Orange>
        <Botania_MysticFlower_Yellow>0.01</Botania_MysticFlower_Yellow>
        <Botania_MysticFlower_Cyan>0.01</Botania_MysticFlower_Cyan>
        <Botania_MysticFlower_Purple>0.01</Botania_MysticFlower_Purple>
        <Botania_MysticFlower_Green>0.01</Botania_MysticFlower_Green>
        <Botania_MysticFlower_Red>0.01</Botania_MysticFlower_Red>
        <Botania_MysticFlower_Black>0.01</Botania_MysticFlower_Black>
      </value>
  </Operation>

</Patch>
