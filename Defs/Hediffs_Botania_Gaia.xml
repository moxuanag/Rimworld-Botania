<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    盖亚护盾：只负责**显示**，出现在小人的健康面板里。
    数值与减伤逻辑由 Botania.Pawn_GaiaBoss 控制，这里只跟着同步 severity。
  -->
  <HediffDef>
    <defName>Botania_GaiaShield</defName>
    <label>gaia shield</label>
    <description>A lattice of green light wrapped around the world-soul. While it holds, almost nothing reaches the body underneath; when it breaks, the thing behind it goes still.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="Botania.HediffCompProperties_GaiaShieldDisplay" />
    </comps>
  </HediffDef>


  <!-- 根须缠绕：定身 3 秒，每 2 秒 2 点自然伤害（优先腿部） -->
  <HediffDef>
    <defName>Botania_GaiaRooted</defName>
    <label>gaia roots</label>
    <description>Roots have come up through the ground and closed around the legs. They do not let go quickly.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>rooted</label>
        <!-- 不用 capMods 把 Moving 压到 0：那会让小人直接进入倒地（incapacitated），
             定身改由 HediffComp 每 tick 停步实现 -->
      </li>
    </stages>
    <comps>
      <li Class="Botania.HediffCompProperties_GaiaRooted">
        <durationTicks>180</durationTicks>
      </li>
    </comps>
  </HediffDef>


  <!--
    盖亚之躯：把关键能力垫到 100%（offset +1）。
    目的：Boss 只会被打死，不会因为断腿/失明/缺氧之类的原因进入倒地状态。
    疼痛休克另外由 PawnKindDef.ignoresPainShock 关掉。
  -->
  <HediffDef>
    <defName>Botania_GaiaUnstoppable</defName>
    <label>gaia body</label>
    <description>Root and stone hold the shape together. It does not fall over; it comes apart.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <painFactor>0</painFactor>
        <capMods>
          <li><capacity>Moving</capacity><offset>1</offset></li>
          <li><capacity>Consciousness</capacity><offset>1</offset></li>
          <li><capacity>Sight</capacity><offset>1</offset></li>
          <li><capacity>Manipulation</capacity><offset>1</offset></li>
          <li><capacity>Breathing</capacity><offset>1</offset></li>
          <li><capacity>BloodPumping</capacity><offset>1</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>


  <!--
    盖亚之赐：同时穿着盖亚甲 + 盖亚头盔时获得的套装加成。
    数值全在这里，调平衡只改这个 Def。
  -->
  <HediffDef>
    <defName>Botania_GaiaSetBonus</defName>
    <label>gaia blessing</label>
    <description>The full Gaia panoply answers to its wearer. Root-light runs along the seams, and the body moves like something that grew into the shape rather than being fitted to it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.35</MoveSpeed>
          <WorkSpeedGlobal>0.20</WorkSpeedGlobal>
          <ImmunityGainSpeed>0.30</ImmunityGainSpeed>
          <IncomingDamageFactor>-0.10</IncomingDamageFactor>
          <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
