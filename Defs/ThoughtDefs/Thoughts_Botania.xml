<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       灵思被引（心情）：由阿卡纳蔷薇在范围内持续补挂，离开后自然淡出。
       Mood 是 Need 而非 Stat，所以心情必须走 Thought，不能写在 hediff 的 statOffsets 里。
       ============================================================ -->

  <ThoughtDef>
    <defName>Botania_ThoughtSiphoned</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>thought siphoned</label>
        <description>Something nearby keeps drinking the ideas out of my head. I can't concentrate.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 劳累（心情）：苦丽花抽走精力时补挂，0.5 天自然淡出，最多叠 3 层。
       defName 刻意与 HediffDef 不同名，避免翻译键撞车。 -->
  <ThoughtDef>
    <defName>Botania_WorkFatigueThought</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>work fatigue</label>
        <description>I finished the job, but something drained the satisfaction right out of it.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
