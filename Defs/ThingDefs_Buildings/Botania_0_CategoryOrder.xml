<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       建筑师菜单排序参考（0.9.2：折叠分组从 5 个减到 2 个）

       只剩「产魔花」与「防御花」是下拉分组；建筑 / 生产建筑 / 功能花
       已平铺进「植物魔法」分类（无 designatorDropdown）。

       显示顺序由 uiOrder 决定：Designator_Build.Order => uiOrder，
       GizmoGridDrawer 在分类内按 Order 升序稳定排序；下拉按钮的 Order
       取组内第一个 def 的 uiOrder。当前值：
         平铺：建筑 2901~2906 -> 生产建筑 3000~3006 -> 功能花 3100
         折叠：产魔花 3202 起 -> 防御花 3400 起

       本文件按字母序排在 Buildings_Botania*.xml 之前，只用来放几个
       代表性 def；排序早已不依赖加载顺序，改 uiOrder 即可。
       ============================================================ -->

<ThingDef ParentName="BuildingBase">
    <defName>Botania_ManaPool</defName>
    <label>mana pool</label>
    <description>A shallow livingwood basin lined with manasteel, holding a pool of light that moves on its own. It gathers what the flowers near it make and shares it out with the pools beside it; flowers and devices draw from the range it feeds.

What the pool holds is not water but a light that moves itself; when the wind passes, it moves first.</description>
    <thingClass>Botania.Building_ManaPool</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/ManaPool</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(2.4,0.6,2.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(3,3)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.25</Flammability>
      <Beauty>3</Beauty>
      <MarketValue>1952</MarketValue>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>25</Botania_ManasteelIngot>
      <Botania_Livingwood>20</Botania_Livingwood>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaStorage">
        <maxMana>100000</maxMana>
        <initialMana>0</initialMana>
        <acceptsMana>true</acceptsMana>
        <balanceWithAdjacentPools>true</balanceWithAdjacentPools>
        <networkRadius>7</networkRadius>
      </li>
    </comps>
    <!-- 放置蓝图时画出半径 6 的连接范围环（范围内的花/通量场能找到这个池子） -->
    <placeWorkers>
      <li>Botania.PlaceWorker_ManaRadius</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_ManaStorage</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <uiOrder>2901</uiOrder>
  </ThingDef>
<ThingDef ParentName="BuildingBase">
    <defName>Botania_PureDaisy</defName>
    <label>pure daisy</label>
    <description>She teaches dead material to live. Set her beside logs or cut stone blocks and she turns the logs into livingwood and the stone into livingstone. With a pool or relay nearby she works faster; without one she works anyway.

A pale ring of light turns around its petals, and only up close do you see that it is turning.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/PureDaisy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>3</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>4</Beauty>
      <MarketValue>32</MarketValue>
    </statBases>
    <costList>
      <Botania_Petal_White>4</Botania_Petal_White>
      <WoodLog>4</WoodLog>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaTransmuter">
        <workTicks>300</workTicks>
        <manaPerWork>20</manaPerWork>
        <!-- 附近没有魔力池/中继塔时，转化间隔乘以这个倍数（且不消耗魔力） -->
        <noManaSlowdown>5</noManaSlowdown>
        <rules>
          <li>
            <fromDef>WoodLog</fromDef>
            <toDef>Botania_Livingwood</toDef>
            <count>1</count>
          </li>
          <li>
            <fromCategory>StoneBlocks</fromCategory>
            <toDef>Botania_Livingrock</toDef>
            <count>1</count>
          </li>
        </rules>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
      <!-- 内圈：它真正能转化的那 8 格（1x1 外扩一格，含斜角） -->
      <li Class="Botania.CompProperties_SecondaryRing">
        <radius>1.5</radius>
      </li>
    </comps>
    <!-- 放置时显示外圈（吸魔 6 格）与内圈（转化 1 格） -->
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_Garden</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3000</uiOrder>
  </ThingDef>
<ThingDef ParentName="BuildingBase">
    <defName>Botania_Endoflame</defName>
    <designatorDropdown>Botania_ManaFlowers</designatorDropdown>
    <label>endoflame</label>
    <description>A flower that grows on ash. Long ago she loved watching things be swallowed by fire: wood goes in, ash comes out. Feed her wood, livingwood or fuel, and she turns it slowly into mana for the pools nearby; if no pool will take it, she would rather let the fuel sit than waste it.

The little fire at its heart does not burn the hand; it only burns quietly, as though someone inside were keeping a stove.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/Endoflame</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.75,0.4,0.75)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.20</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
      <MarketValue>693</MarketValue>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>8</Botania_ManasteelIngot>
      <Botania_Livingwood>12</Botania_Livingwood>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>50</fuelCapacity>
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
            <li>Chemfuel</li>
            <li>Botania_Livingwood</li>
          </thingDefs>
        </fuelFilter>
      </li>
      <li Class="Botania.CompProperties_ManaFlower">
        <manaPerFuel>3000</manaPerFuel>
        <fuelPerSecond>0.01</fuelPerSecond>
        <radius>6</radius>
        <burnFuelWithoutPool>false</burnFuelWithoutPool>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_EndoflameStudy</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3202</uiOrder>
  </ThingDef>
<ThingDef ParentName="BuildingBase">
    <defName>Botania_ThornFlower</defName>
    <designatorDropdown>Botania_DefenseFlowers</designatorDropdown>
    <label>thorn flower</label>
    <description>She lies low and waits to be stepped on. Left alone she only snags clothing; fed with mana she pushes new points up under the feet of whatever enters her range. The more come, the faster she works.

A whole mat of thorned vine; the dark purple bloom at its centre barely sways, while the thorns keep growing.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/ThornFlower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>-2</Beauty>
      <MarketValue>372</MarketValue>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>4</Botania_ManasteelIngot>
      <Botania_Livingwood>6</Botania_Livingwood>
      <Botania_Petal_Red>2</Botania_Petal_Red>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ThornFlower">
        <radius>10</radius>
        <workIntervalTicks>90</workIntervalTicks>
        <damagePerPulse>1</damagePerPulse>
        <manaPerTarget>2</manaPerTarget>
        <maxTargets>12</maxTargets>
        <manaCapacity>150</manaCapacity>
        <rechargePerSecond>25</rechargePerSecond>
        <slowHediff>Botania_ThornsSlow</slowHediff>
        <slowDuration>90</slowDuration>
        <thornMote>Botania_Mote_Thorn</thornMote>
      </li>
      <!-- 作用范围环：选中时常驻显示，放置时预览（半径与上面一致） -->
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>10</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_ThornFlowerStudy</li>
    </researchPrerequisites>
    <uiOrder>3400</uiOrder>
  </ThingDef>
<ThingDef ParentName="BuildingBase">
    <defName>Botania_ClearMindLotus</defName>
    <label>clear-mind lotus</label>
    <description>She keeps a counter-melody under her petals. While she is fed, everyone in range goes quiet inside: the thoughts are pushed gently out, and nothing else changes. Cut the mana and they come straight back.

The tune it hums cannot be heard, but whoever stands nearby suddenly forgets what they were afraid of.</description>
