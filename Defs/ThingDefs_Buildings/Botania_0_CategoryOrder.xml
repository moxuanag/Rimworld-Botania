<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       分类排序锚点（不要随意删改顺序）

       建筑师菜单里「植物魔法」分类下的 5 个下拉分组，其排列顺序由
       DesignationCategoryDef.ResolveDesignators() 的「第一次遇到」顺序决定，
       而那个顺序就是 DefDatabase 的加载顺序（XML 文件路径字母序）。

       本文件按字母序排在 Buildings_Botania*.xml 之前，因此这里 5 个 def 的
       先后顺序 = 5 个分组按钮的先后顺序：
         建筑 -> 生产建筑 -> 产魔花 -> 防御花 -> 功能花
       其余同类建筑分散在原文件中，它们只是追加进各自分组，不影响分组顺序。
       ============================================================ -->

<ThingDef ParentName="BuildingBase">
    <defName>Botania_ManaPool</defName>
    <designatorDropdown>Botania_Buildings</designatorDropdown>
    <label>mana pool</label>
    <description>A shallow basin of livingwood lined with manasteel, filled with liquid light. It stores mana produced by nearby flowers and shares it with adjacent pools.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/ManaPool</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(2.4,0.6,2.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(3,3)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.25</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>25</Botania_ManasteelIngot>
      <Botania_Livingwood>20</Botania_Livingwood>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaStorage">
        <maxMana>100000</maxMana>
        <initialMana>0</initialMana>
        <acceptsMana>true</acceptsMana>
        <balanceWithAdjacentPools>true</balanceWithAdjacentPools>
        <networkRadius>7</networkRadius>
      </li>
      <!-- 选中时也显示半径 6 的供给范围 -->
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <!-- 放置蓝图时画出半径 6 的连接范围环（范围内的花/通量场能找到这个池子） -->
    <placeWorkers>
      <li>Botania.PlaceWorker_ManaRadius</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_ManaStorage</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <uiOrder>3100</uiOrder>
  </ThingDef>
<ThingDef ParentName="BuildingBase">
    <defName>Botania_PureDaisy</defName>
    <designatorDropdown>Botania_ProduceBuildings</designatorDropdown>
    <label>pure daisy</label>
    <description>A white daisy with a faint ring of light around its petals.\n\nPlace it next to a pile of logs or a pile of stone blocks - the cut stone bricks such as granite blocks or limestone blocks, not raw chunks - and it slowly teaches the material to be alive: logs become livingwood, stone blocks become livingrock.\n\nEach transformation costs a little mana from a mana pool or relay within 6 tiles. Without one it still works, but takes five times as long and costs nothing.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/PureDaisy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>3</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <costList>
      <Botania_Petal_White>4</Botania_Petal_White>
      <WoodLog>4</WoodLog>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaTransmuter">
        <workTicks>300</workTicks>
        <manaPerWork>20</manaPerWork>
        <!-- 附近没有魔力池/中继塔时，转化间隔乘以这个倍数（且不消耗魔力） -->
        <noManaSlowdown>5</noManaSlowdown>
        <rules>
          <li>
            <fromDef>WoodLog</fromDef>
            <toDef>Botania_Livingwood</toDef>
            <count>1</count>
          </li>
          <li>
            <fromCategory>StoneBlocks</fromCategory>
            <toDef>Botania_Livingrock</toDef>
            <count>1</count>
          </li>
        </rules>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
      <!-- 内圈：它真正能转化的那 8 格（1x1 外扩一格，含斜角） -->
      <li Class="Botania.CompProperties_SecondaryRing">
        <radius>1.5</radius>
      </li>
    </comps>
    <!-- 放置时显示外圈（吸魔 6 格）与内圈（转化 1 格） -->
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_BasicMana</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3003</uiOrder>
  </ThingDef>
<ThingDef ParentName="BuildingBase">
    <defName>Botania_Endoflame</defName>
    <designatorDropdown>Botania_ManaFlowers</designatorDropdown>
    <label>endoflame</label>
    <description>A flower that eats fire. Fed with wood, livingwood or chemfuel, it slowly converts the fuel into mana and sends it drifting into a nearby mana pool. It will not burn fuel if no pool can take the mana.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/Endoflame</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.75,0.4,0.75)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.20</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>8</Botania_ManasteelIngot>
      <Botania_Livingwood>12</Botania_Livingwood>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>50</fuelCapacity>
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
            <li>Chemfuel</li>
            <li>Botania_Livingwood</li>
          </thingDefs>
        </fuelFilter>
      </li>
      <li Class="Botania.CompProperties_ManaFlower">
        <manaPerFuel>3000</manaPerFuel>
        <fuelPerSecond>0.01</fuelPerSecond>
        <radius>6</radius>
        <burnFuelWithoutPool>false</burnFuelWithoutPool>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_GeneratingI</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3202</uiOrder>
  </ThingDef>
<ThingDef ParentName="BuildingBase">
    <defName>Botania_ThornFlower</defName>
    <designatorDropdown>Botania_DefenseFlowers</designatorDropdown>
    <label>thorn flower</label>
    <description>A low mat of briars with a dark bloom at its heart. Left alone it only snags clothes; fed with mana it throws fresh thorns up under anything hostile that wanders into range, and the more of them there are, the faster it drains the pool.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/ThornFlower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>4</Botania_ManasteelIngot>
      <Botania_Livingwood>6</Botania_Livingwood>
      <Botania_Petal_Red>2</Botania_Petal_Red>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ThornFlower">
        <radius>10</radius>
        <workIntervalTicks>60</workIntervalTicks>
        <damagePerPulse>3</damagePerPulse>
        <manaPerTarget>2</manaPerTarget>
        <maxTargets>12</maxTargets>
        <manaCapacity>150</manaCapacity>
        <rechargePerSecond>25</rechargePerSecond>
        <slowHediff>Botania_ThornsSlow</slowHediff>
        <slowDuration>90</slowDuration>
        <thornMote>Botania_Mote_Thorn</thornMote>
      </li>
      <!-- 作用范围环：选中时常驻显示，放置时预览（半径与上面一致） -->
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>10</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_FunctionalI</li>
    </researchPrerequisites>
    <uiOrder>3400</uiOrder>
  </ThingDef>
<ThingDef ParentName="BuildingBase">
    <defName>Botania_ClearMindLotus</defName>
    <designatorDropdown>Botania_FunctionFlowers</designatorDropdown>
    <label>clear-mind lotus</label>
    <description>A pale lotus that hums a counter-note. While it is fed, everyone within range simply does not hear a psychic drone: that one thought is pushed out of their head, and nothing else about their mood changes. It drinks mana heavily, and without mana the drone comes straight back.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
