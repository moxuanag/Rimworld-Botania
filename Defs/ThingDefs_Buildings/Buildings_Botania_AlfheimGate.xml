<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       精灵之门（Alfheim Gate）：3 件套拼成的真门洞。
         上梁 3×1（承载转换逻辑）
         左柱 1×3 + 右柱 1×3（立在两端，门洞 3×2 真的留空，人可以走）
       设计见 docs/植物魔法开发文档.md §1。
       放置顺序：先立两根柱，再在顶上放上梁；少一根柱时上梁不工作（检视栏会写）。
       ============================================================ -->

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_AlfheimGateLintel</defName>
    <label>elf gate lintel</label>
    <description>The top beam of an elven gate. Once both pillars are standing under its ends, the gate opens: leave livingwood, livingrock or petals in the doorway and it will draw mana from a nearby pool, and turn them into things that do not exist on this world.\n\nIt will not work without mana, and it will not work with a pillar missing.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/AlfheimGateLintel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,1)</drawSize>
      <shadowData>
        <volume>(1.2,0.3,0.3)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>50</pathCost>
    <fillPercent>1</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <!-- 必须显式声明 Normal：CompManaGate 的转化逻辑挂在 CompTick 上 -->
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(3,1)</size>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0.1</Flammability>
      <Beauty>6</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>8</Botania_ManasteelIngot>
      <Botania_Livingrock>6</Botania_Livingrock>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaGate">
        <openingDepth>2</openingDepth>
        <manaSearchRadius>8</manaSearchRadius>
        <framePillarHeight>3</framePillarHeight>
        <framePillarDefs>
          <li>Botania_AlfheimGatePillarLeft</li>
          <li>Botania_AlfheimGatePillarRight</li>
        </framePillarDefs>
        <rules>
          <!-- 梦木：活木 ×4，200 魔力，10 秒 -->
          <li>
            <toDef>Botania_Dreamwood</toDef>
            <manaCost>200</manaCost>
            <workTicks>600</workTicks>
            <inputs>
              <li>
                <fromDef>Botania_Livingwood</fromDef>
                <count>4</count>
              </li>
            </inputs>
          </li>
          <!-- 精灵石英：活石 ×4，200 魔力，10 秒 -->
          <li>
            <toDef>Botania_ElvenQuartz</toDef>
            <manaCost>200</manaCost>
            <workTicks>600</workTicks>
            <inputs>
              <li>
                <fromDef>Botania_Livingrock</fromDef>
                <count>4</count>
              </li>
            </inputs>
          </li>
          <!-- 精灵之尘：任意花瓣 ×2，100 魔力，5 秒 -->
          <li>
            <toDef>Botania_PixieDust</toDef>
            <manaCost>100</manaCost>
            <workTicks>300</workTicks>
            <inputs>
              <li>
                <fromCategory>BotaniaPetals</fromCategory>
                <count>2</count>
              </li>
            </inputs>
          </li>
          <!-- 元素锭：魔力钢 ×2 + 精灵之尘 ×1，300 魔力，30 秒 -->
          <li>
            <toDef>Botania_ElementiumIngot</toDef>
            <manaCost>300</manaCost>
            <workTicks>1800</workTicks>
            <inputs>
              <li>
                <fromDef>Botania_ManasteelIngot</fromDef>
                <count>2</count>
              </li>
              <li>
                <fromDef>Botania_PixieDust</fromDef>
                <count>1</count>
              </li>
            </inputs>
          </li>
        </rules>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_GateFrame</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_Alfheim</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <uiOrder>3201</uiOrder>
  </ThingDef>

  <!-- 左柱：内侧（右边）有石英镶边，右柱靠贴图镜像，两根柱子的 Def 不同，不能混用 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Botania_AlfheimGatePillarLeft</defName>
    <label>elf gate pillar (left)</label>
    <description>A livingwood pillar banded in manasteel, with a strip of elven quartz running down the side that faces the doorway. Two of these and a lintel across the top make a gate.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/AlfheimGatePillarLeft</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,3)</drawSize>
      <shadowData>
        <volume>(0.35,0.3,1.0)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>50</pathCost>
    <fillPercent>1</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,3)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0.1</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Wood_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>4</Botania_ManasteelIngot>
      <Botania_Livingwood>10</Botania_Livingwood>
      <Botania_Livingrock>2</Botania_Livingrock>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_Alfheim</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3202</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_AlfheimGatePillarRight</defName>
