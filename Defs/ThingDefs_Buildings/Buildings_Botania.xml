<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       魔力池：储存魔力（CompManaStorage），可与相邻魔力池均摊。
       火红莲：消耗燃料产出魔力（CompRefuelable + CompManaFlower）。
       ============================================================ -->

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_ManaPool</defName>
    <label>mana pool</label>
    <description>A shallow basin of livingwood lined with manasteel, filled with liquid light. It stores mana produced by nearby flowers and shares it with adjacent pools.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/ManaPool</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(2.4,0.6,2.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(3,3)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.25</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>25</Botania_ManasteelIngot>
      <Botania_Livingwood>20</Botania_Livingwood>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaStorage">
        <maxMana>100000</maxMana>
        <initialMana>0</initialMana>
        <acceptsMana>true</acceptsMana>
        <balanceWithAdjacentPools>true</balanceWithAdjacentPools>
      </li>
      <!-- 选中时也显示半径 6 的供给范围 -->
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <!-- 放置蓝图时画出半径 6 的连接范围环（范围内的花/通量场能找到这个池子） -->
    <placeWorkers>
      <li>Botania.PlaceWorker_ManaRadius</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_BasicMana</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <uiOrder>3100</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_Endoflame</defName>
    <label>endoflame</label>
    <description>A flower that eats fire. Fed with wood, livingwood or chemfuel, it slowly converts the fuel into mana and sends it drifting into a nearby mana pool. It will not burn fuel if no pool can take the mana.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/Endoflame</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.75,0.4,0.75)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.20</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>8</Botania_ManasteelIngot>
      <Botania_Livingwood>12</Botania_Livingwood>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>50</fuelCapacity>
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
            <li>Chemfuel</li>
            <li>Botania_Livingwood</li>
          </thingDefs>
        </fuelFilter>
      </li>
      <li Class="Botania.CompProperties_ManaFlower">
        <manaPerFuel>3000</manaPerFuel>
        <fuelPerSecond>0.01</fuelPerSecond>
        <radius>6</radius>
        <burnFuelWithoutPool>false</burnFuelWithoutPool>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_GeneratingI</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3101</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_ManaFluxfield</defName>
    <label>mana fluxfield</label>
    <description>A lattice of manasteel coils around a mote of bottled light. It pulls mana out of a nearby pool and turns it into ordinary electric power. It runs only while it can find mana to draw.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/ManaFluxfield</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.7,0.35,0.7)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.20</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>0.2</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>10</Botania_ManasteelIngot>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Flickable"/>
      <li Class="Botania.CompProperties_ManaFluxfield">
        <basePowerConsumption>-1000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <manaPerSecond>1.5</manaPerSecond>
        <searchRadius>6</searchRadius>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_Infusion</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <uiOrder>3102</uiOrder>
  </ThingDef>

  <!-- ============================================================
       魔力中继塔：把魔力供给范围沿链向外延伸，每跳损耗 10%。
       设计见 PROGRESS.md 第十五节（范围+中继方案）。
       ============================================================ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Botania_ManaRelay</defName>
    <label>mana relay tower</label>
    <description>A slender spire of livingwood wrapped in manasteel coils, capped with a mote of drifting light. It draws mana from a pool or from an upstream relay and holds it in its own small buffer, so devices further away can tap it. Each hop costs a tenth of the mana.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/ManaRelay</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.5,0.3,0.5)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.30</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <!-- 必须显式声明 Normal：CompManaRelay 的逻辑挂在 CompTick 上 -->
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Mass>15</Mass>
      <Flammability>0.3</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>5</Botania_ManasteelIngot>
      <Botania_Livingwood>10</Botania_Livingwood>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaRelay">
        <capacity>6000</capacity>
        <radius>8</radius>
        <manaPerSecond>40</manaPerSecond>
        <lossPercent>0.1</lossPercent>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>8</radius>
      </li>
    </comps>
    <!-- 放置时显示半径 6 的供给范围环 -->
    <placeWorkers>
      <li>Botania.PlaceWorker_ManaRelayNetwork</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_ManaGrid</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3103</uiOrder>
  </ThingDef>

  <!-- ============================================================
       白雏菊：把相邻格的木头转成活木、石砖转成活石，每次消耗魔力。
       不需要小人操作，是本模组的自动化材料入口。
       ============================================================ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Botania_PureDaisy</defName>
    <label>pure daisy</label>
    <description>A white daisy with a faint ring of light around its petals.\n\nPlace it next to a pile of logs or a pile of stone blocks - the cut stone bricks such as granite blocks or limestone blocks, not raw chunks - and it slowly teaches the material to be alive: logs become livingwood, stone blocks become livingrock.\n\nEach transformation costs a little mana from a mana pool within 6 tiles.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/PureDaisy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>3</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <costList>
      <Botania_Petal_White>4</Botania_Petal_White>
      <Botania_Livingwood>2</Botania_Livingwood>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaTransmuter">
        <ticksPerConvert>300</ticksPerConvert>
        <manaPerConvert>20</manaPerConvert>
        <manaSearchRadius>6</manaSearchRadius>
        <rules>
          <li>
            <fromDef>WoodLog</fromDef>
            <toDef>Botania_Livingwood</toDef>
            <count>1</count>
          </li>
          <li>
            <fromCategory>StoneBlocks</fromCategory>
            <toDef>Botania_Livingrock</toDef>
            <count>1</count>
          </li>
        </rules>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <!-- 放置时显示半径 6 的魔力供给范围 -->
    <placeWorkers>
      <li>Botania.PlaceWorker_ManaRadius</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_BasicMana</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3104</uiOrder>
  </ThingDef>

  <!-- ============================================================
       建筑恢复器：用魔力修半径 8 内自己阵营建筑的耐久。
       · 每 1 秒一个周期，最多照顾 4 个目标，越破的越优先
       · 每个目标最多 +5 耐久/周期，每点耐久 2 魔力（上限 20 耐久 = 40 魔力/秒）
       · 魔力不够就按实际抽到的量打折修复，抽不到就停手
       ============================================================ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Botania_StructureRepairer</defName>
    <label>structure repairer</label>
    <description>A livingrock frame wrapped around a wall of mana-veined stone. Held near a mana pool, it seeps mana into cracked walls and slowly knits the masonry back together. It only mends what is already built - it will not finish construction, and it will not touch another faction's walls.</description>
    <thingClass>Building</thingClass>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Botania/StructureRepairer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.7,0.35,0.7)</volume>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>1400</WorkToBuild>
      <Mass>14</Mass>
      <Flammability>0</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <costList>
      <Botania_ManasteelIngot>10</Botania_ManasteelIngot>
      <Botania_Livingrock>15</Botania_Livingrock>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaRepairer">
        <radius>8</radius>
        <manaSearchRadius>6</manaSearchRadius>
        <ticksPerCycle>60</ticksPerCycle>
        <hpPerCycle>5</hpPerCycle>
        <manaPerHp>5</manaPerHp>
        <maxTargets>4</maxTargets>
        <repairBuildings>true</repairBuildings>
        <repairItems>false</repairItems>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>8</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_ManaRepairRadius</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites>
      <li>Botania_Mending</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3105</uiOrder>
  </ThingDef>

  <!-- ============================================================
       装备修复器：用魔力修半径 6 内地上装备/武器/服装的耐久。
       · 每 1 秒一个周期，最多 4 个目标，越破的越优先
       · 每个目标最多 +6 耐久/周期，每点耐久 1.5 魔力
       ============================================================ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Botania_ItemRepairer</defName>
    <label>item repairer</label>
    <description>A livingwood bench with a manasteel anvil and a clamp of woven mana. Any worn weapon, tool or piece of apparel left on it is soaked in mana until the cracks close. It mends what is already made - it cannot repair something that has been destroyed outright.</description>
    <thingClass>Building</thingClass>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Botania/ItemRepairer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.7,0.35,0.7)</volume>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>0.4</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <Botania_ManasteelIngot>10</Botania_ManasteelIngot>
      <Botania_Livingwood>12</Botania_Livingwood>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaRepairer">
        <radius>6</radius>
        <manaSearchRadius>6</manaSearchRadius>
        <ticksPerCycle>60</ticksPerCycle>
        <hpPerCycle>6</hpPerCycle>
        <manaPerHp>5</manaPerHp>
        <maxTargets>4</maxTargets>
        <repairBuildings>false</repairBuildings>
        <repairItems>true</repairItems>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_ManaRepairRadius</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites>
      <li>Botania_Mending</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <uiOrder>3106</uiOrder>
  </ThingDef>

</Defs>
