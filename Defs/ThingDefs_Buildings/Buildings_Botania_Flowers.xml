<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       新增花（0.7 花线）：
         噬草花   —— 吃枯萎病作物产魔（产能花，归「进阶产能花」）
         苦丽花   —— 半径内小人完成一件工作，就抽一份劳累换魔力（产能花）
         明心莲   —— 抵挡心灵干扰（功能花，归「功能花」），吃魔很凶
       ============================================================ -->

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_BlightEater</defName>
    <label>blight eater</label>
    <description>A flower that feeds on sickness. It seeks out blighted crops within a few tiles, swallows one whole, and wrings what mana it can out of the rot. It will not touch healthy plants - so it is a scavenger that happens to clean your fields.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/BlightEater</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>2</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <costList>
      <Botania_Petal_Green>4</Botania_Petal_Green>
      <Botania_ManaPowder>4</Botania_ManaPowder>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaBlightEater">
        <radius>6</radius>
        <manaPerPlant>1500</manaPerPlant>
        <ticksBetweenMeals>300</ticksBetweenMeals>
        <poolRadius>6</poolRadius>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_GeneratingII</li>
    </researchPrerequisites>
    <uiOrder>3260</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_BitterBloom</defName>
    <label>bitter bloom</label>
    <description>A flower that lives off other people's labour. Every time someone within range finishes a real piece of work, the bloom takes a little of their energy, and pays them back with aching fatigue and a sour mood. Idlers feed it nothing.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/BitterBloom</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <WorkToBuild>450</WorkToBuild>
      <Mass>2</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <costList>
      <Botania_Petal_Red>4</Botania_Petal_Red>
      <Botania_ManaPowder>6</Botania_ManaPowder>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaBitterBloom">
        <radius>8</radius>
        <manaPerXp>10</manaPerXp>
        <maxManaPerWork>400</maxManaPerWork>
        <trivialXpThreshold>5</trivialXpThreshold>
        <trivialCooldownTicks>3600</trivialCooldownTicks>
        <fatigueSeverity>0.25</fatigueSeverity>
        <hediffDef>Botania_WorkFatigue</hediffDef>
        <thoughtDef>Botania_WorkFatigueThought</thoughtDef>
        <poolRadius>6</poolRadius>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>8</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_GeneratingII</li>
    </researchPrerequisites>
    <uiOrder>3270</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_ClearMindLotus</defName>
    <label>clear-mind lotus</label>
    <description>A pale lotus that hums a counter-note. While it is fed, everyone within range simply does not hear a psychic drone: that one thought is pushed out of their head, and nothing else about their mood changes. It drinks mana heavily, and without mana the drone comes straight back.</description>
