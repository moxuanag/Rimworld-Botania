<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       新增花（0.7 花线）：
         噬草花   —— 吃枯萎病作物产魔（产能花，归「进阶产能花」）
         苦丽花   —— 半径内小人完成一件工作，就抽一份劳累换魔力（产能花）
         明心莲   —— 抵挡心灵干扰（功能花，归「功能花」），吃魔很凶
       ============================================================ -->

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_BlightEater</defName>
    <designatorDropdown>Botania_ManaFlowers</designatorDropdown>
    <label>blight eater</label>
    <description>She feeds on sickness. She follows the smell of rot, swallows a blighted crop whole and wrings mana out of the rotten part. Healthy plants she never touches.

It only cares for sick plants; when the field is clean it is just another tuft of grass.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/BlightEater</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>2</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>1</Beauty>
      <MarketValue>147</MarketValue>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <costList>
      <Botania_Petal_Green>4</Botania_Petal_Green>
      <Botania_ManaPowder>4</Botania_ManaPowder>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaBlightEater">
        <plantRadius>6</plantRadius>
        <manaPerPlant>1500</manaPerPlant>
        <settleIntervalTicks>180</settleIntervalTicks>
        <mealsPerBatch>10</mealsPerBatch>
        <restTicks>1800</restTicks>
        <radius>6</radius>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>6</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_BlightEaterStudy</li>
    </researchPrerequisites>
    <uiOrder>3206</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_BitterBloom</defName>
    <designatorDropdown>Botania_ManaFlowers</designatorDropdown>
    <label>bitter bloom</label>
    <description>She lives off other people's labour. When someone works nearby, she takes a little of their craft and gives back soreness and irritation. Idlers cannot feed her.

It is not an ugly flower, but anyone working beside it will sigh for no reason at all.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/BitterBloom</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <WorkToBuild>450</WorkToBuild>
      <Mass>2</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
      <MarketValue>195</MarketValue>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <costList>
      <Botania_Petal_Red>4</Botania_Petal_Red>
      <Botania_ManaPowder>6</Botania_ManaPowder>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ManaBitterBloom">
        <workRadius>8</workRadius>
        <manaPerXp>10</manaPerXp>
        <maxManaPerWork>400</maxManaPerWork>
        <trivialXpThreshold>5</trivialXpThreshold>
        <trivialCooldownTicks>3600</trivialCooldownTicks>
        <fatigueSeverity>0.25</fatigueSeverity>
        <hediffDef>Botania_WorkFatigue</hediffDef>
        <thoughtDef>Botania_WorkFatigueThought</thoughtDef>
        <radius>6</radius>
      </li>
      <li Class="Botania.CompProperties_RadiusRing">
        <radius>8</radius>
      </li>
    </comps>
    <placeWorkers>
      <li>Botania.PlaceWorker_RadiusFromComp</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Botania</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_BitterBloomStudy</li>
    </researchPrerequisites>
    <uiOrder>3207</uiOrder>
  </ThingDef>

  

</Defs>
