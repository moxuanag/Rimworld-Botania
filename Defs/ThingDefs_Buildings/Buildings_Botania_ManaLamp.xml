<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 精灵灯：不用电的灯，从魔力网络抽 1 魔力 / 60 秒，断魔即熄灭。
       实现见 Source/CompManaLamp.cs：不碰 CompGlower 内部，
       而是代替玩家去拨原版灯的 CompFlickable 开关。 -->
  <ThingDef ParentName="LampBase">
    <defName>Botania_ManaLamp</defName>
    <label>mana lamp</label>
    <description>A quartz lamp that drinks mana instead of power. A quiet mana glow drifts inside the glass; when the mana runs out the light fades, and it wakes again once the supply returns.</description>
    <graphicData>
      <texPath>Things/Building/Botania/ManaLamp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costList>
      <Botania_ElvenQuartz>2</Botania_ElvenQuartz>
      <Botania_PixieDust>1</Botania_PixieDust>
      <Botania_ManasteelIngot>2</Botania_ManasteelIngot>
    </costList>
    <statBases>
      <Mass>3</Mass>
      <WorkToBuild>800</WorkToBuild>
      <MarketValue>253</MarketValue>
    </statBases>
    <tickerType>Normal</tickerType>
    <uiOrder>2995</uiOrder>
    <researchPrerequisites>
      <li>Botania_ManaLampStudy</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(253,232,180,0)</glowColor>
        <!-- 和原版灯一样：研究完「高级照明 / ColoredLights」后可以改灯光颜色。
             未研究时按钮会显示为禁用并说明原因（引擎自动处理，无需我们写代码）。 -->
        <colorPickerEnabled>true</colorPickerEnabled>
      </li>
      <li Class="Botania.CompProperties_ManaLamp">
        <manaPerWork>1</manaPerWork>
        <workIntervalTicks>3600</workIntervalTicks>
        <retryIntervalTicks>300</retryIntervalTicks>
      </li>
    </comps>
  </ThingDef>

</Defs>
