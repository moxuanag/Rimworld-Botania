<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       功能花（Functional Flowers）：会替殖民地干活的建筑。
       目前只有荆棘花，攻击逻辑尚未接入（Def 与贴图先落地）。
       规划组件：Botania.CompProperties_ThornFlower
       ============================================================ -->

  <ThingDef ParentName="BuildingBase">
    <defName>Botania_ThornFlower</defName>
    <label>thorn flower</label>
    <description>A low mat of briars with a dark bloom at its heart. Left alone it only snags clothes; fed with mana it throws fresh thorns up under anything hostile that wanders into range, and the more of them there are, the faster it drains the pool.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Botania/ThornFlower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6,0.3,0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <costList>
      <Botania_ManasteelIngot>4</Botania_ManasteelIngot>
      <Botania_Livingwood>6</Botania_Livingwood>
      <Botania_Petal_Red>2</Botania_Petal_Red>
    </costList>
    <comps>
      <li Class="Botania.CompProperties_ThornFlower">
        <radius>10</radius>
        <sourceRadius>10</sourceRadius>
        <pulseTicks>30</pulseTicks>
        <damagePerPulse>3</damagePerPulse>
        <manaPerTarget>2</manaPerTarget>
        <maxTargets>12</maxTargets>
        <slowHediff>Botania_ThornsSlow</slowHediff>
        <slowDuration>90</slowDuration>
        <thornMote>Botania_Mote_Thorn</thornMote>
      </li>
    </comps>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <thingCategories>
      <li>BotaniaBuildings</li>
    </thingCategories>
    <researchPrerequisites>
      <li>Botania_FunctionalI</li>
    </researchPrerequisites>
    <uiOrder>3230</uiOrder>
  </ThingDef>

</Defs>
