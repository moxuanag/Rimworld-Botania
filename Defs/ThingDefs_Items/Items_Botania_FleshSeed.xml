<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       血肉之种：启命英的燃料。
       来源两条：
         1) 原版血肉心脏（异象 DLC）上挂的按钮定期抽取，心脏被摧毁时也掉一批；
         2) 拆解扭曲肉（Meat_Twisted）——配方本身在 Patches/Botania_Anomaly.xml 里，
            没装 DLC 时不会存在。
       ============================================================ -->

  <ThingDef ParentName="ResourceBase">
    <defName>Botania_FleshSeed</defName>
    <label>flesh seed</label>
    <description>A knot of living tissue that twitches when held. The life orchid uses it as fuel: each seed buys a stretch of generations before the colony of cells dries up.</description>
    <graphicData>
      <texPath>Things/Item/Botania/FleshSeed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9,0.9)</drawSize>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>25</MarketValue>
      <Mass>0.15</Mass>
    </statBases>
    <thingCategories>
      <li>BotaniaItems</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Ingredients" />
    </comps>
  </ThingDef>

</Defs>
