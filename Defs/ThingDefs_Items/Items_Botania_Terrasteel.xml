<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       泰拉钢（Botania_Terrasteel · 4000 点 · 前置「精灵之门」）
         · 泰拉钢锭：魔力钢锭 + 精灵石英 + 20,000 魔力，在泰拉凝聚台里合成
         · 泰拉刃 / 泰拉甲 / 泰拉头盔 / 泰拉碎岩镐，各自吃 1 锭
         · 1 锭 = 1 件装备（已定，见开发文档第一部分 §9–§10）
       ============================================================ -->

  <!-- 泰拉钢锭：终局主料 -->
  <ThingDef ParentName="Botania_MaterialBase">
    <defName>Botania_TerrasteelIngot</defName>
    <label>terrasteel ingot</label>
    <description>The metal that grows. Manasteel fed with elven quartz inside the agglomeration platform stops being metal in the ordinary sense and starts putting out roots. Green-gold, warm to the touch, and heavier than it looks.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/TerrasteelIngot</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>700</MarketValue>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>0.4</Mass>
      <Flammability>0.0</Flammability>
      <DeteriorationRate>0.0</DeteriorationRate>
    </statBases>
  </ThingDef>

  <!-- 泰拉刃：30 伤害 / 45% 穿透 / 2.0 秒；装备后获得「剑气」技能 -->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>Botania_TerraBlade</defName>
    <label>terrasteel blade</label>
    <description>A terrasteel blade on a livingwood grip. The edge is ordinary enough; what is not ordinary is that the metal remembers the swing. Hold it and the air in front of you can be made to move with it.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Botania/TerrasteelSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.15,1.15)</drawSize>
    </graphicData>
    <techLevel>Ultra</techLevel>
    <weaponTags>
      <li>BotaniaMelee</li>
    </weaponTags>
    <statBases>
      <WorkToMake>24000</WorkToMake>
      <Mass>2.4</Mass>
      <MarketValue>2400</MarketValue>
    </statBases>
    <costList>
      <Botania_TerrasteelIngot>1</Botania_TerrasteelIngot>
      <Botania_Livingwood>2</Botania_Livingwood>
      <Botania_PixieDust>2</Botania_PixieDust>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_Terrasteel</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>353</displayPriority>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <tools>
      <li>
        <label>pommel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2.0</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>26</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetration>0.35</armorPenetration>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetration>0.45</armorPenetration>
      </li>
    </tools>
    <comps>
      <li Class="Botania.CompProperties_TerraBlade">
        <waveManaCost>400</waveManaCost>
        <searchRadius>8</searchRadius>
      </li>
    </comps>
  </ThingDef>

  <!-- 泰拉甲（毕业装备）：锐器 125% / 钝器 62% / 热能 50%
       参考基准：元素甲 90% / 45% / 25%，原版顶级动力甲约 120% / 62%。
       定位是「把一条科技线走到底」的终点，所以三项全面压过元素甲，
       锐器与钝器都达到或超过原版最好的甲，热能也补上（元素甲热能只有 25%）。
       代价不变：质量 9、移速 -0.10、需要工艺 8。 -->
  <ThingDef ParentName="ApparelBase">
    <defName>Botania_TerrasteelArmor</defName>
    <label>terrasteel armor</label>
    <description>A suit of terrasteel plate that keeps growing into its own scratches. It stops a blade almost completely; a hammer still finds a way through.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Botania_TerrasteelArmor/Botania_TerrasteelArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.00</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <MaxHitPoints>400</MaxHitPoints>
      <Mass>9</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>1.25</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.62</ArmorRating_Blunt>
      <ArmorRating_Heat>0.50</ArmorRating_Heat>
      <Insulation_Cold>16</Insulation_Cold>
      <Insulation_Heat>6</Insulation_Heat>
      <EquipDelay>5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.10</MoveSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <costList>
      <Botania_TerrasteelIngot>1</Botania_TerrasteelIngot>
      <Botania_Livingwood>2</Botania_Livingwood>
      <Botania_PixieDust>2</Botania_PixieDust>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_Terrasteel</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>350</displayPriority>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Botania_TerrasteelArmor/Botania_TerrasteelArmor</wornGraphicPath>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Hands</li>
        <li>Legs</li>
        <li>Feet</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
    </apparel>
  </ThingDef>

  <!-- 泰拉头盔（毕业装备）：锐器 75% / 钝器 37% / 热能 40%
       与泰拉甲保持 0.6 的比例（元素套也是 0.6），热能略低于甲但明显高于元素头盔。
       头盔不加移速惩罚。 -->
  <ThingDef ParentName="ApparelBase">
    <defName>Botania_TerrasteelHelmet</defName>
    <label>terrasteel helmet</label>
    <description>A full helm of terrasteel with a visor of elven quartz. The metal closes over the face on its own; the opening is exactly wide enough to see through.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Botania_TerrasteelHelmet/Botania_TerrasteelHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.00</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <MaxHitPoints>280</MaxHitPoints>
      <Mass>3</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>0.75</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.37</ArmorRating_Blunt>
      <ArmorRating_Heat>0.40</ArmorRating_Heat>
      <Insulation_Cold>6</Insulation_Cold>
      <Insulation_Heat>2</Insulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <thingCategories>
      <li>ArmorHeadgear</li>
    </thingCategories>
    <costList>
      <Botania_TerrasteelIngot>1</Botania_TerrasteelIngot>
      <Botania_PixieDust>1</Botania_PixieDust>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_Terrasteel</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>351</displayPriority>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Botania_TerrasteelHelmet/Botania_TerrasteelHelmet</wornGraphicPath>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <parentTagDef>ApparelHead</parentTagDef>
    </apparel>
  </ThingDef>

  <!-- 泰拉碎岩镐：采矿速度 +50%，采矿时周围八格同步被挖，兼作近战工具 -->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>Botania_TerrasteelPick</defName>
    <label>terrasteel pick</label>
    <description>A pick of terrasteel and livingwood. The head drinks the shock of the strike, so it bites deeper with each swing than its weight suggests.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Botania/TerrasteelPick</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.15,1.15)</drawSize>
    </graphicData>
    <techLevel>Ultra</techLevel>
    <weaponTags>
      <li>BotaniaTool</li>
    </weaponTags>
    <statBases>
      <WorkToMake>16000</WorkToMake>
      <Mass>2.6</Mass>
      <MarketValue>1600</MarketValue>
    </statBases>
    <!-- 挖矿速度 base 1 → 2（×2）；矿物掉落 base 1 → 3（×3） -->
    <equippedStatOffsets>
      <MiningSpeed>1</MiningSpeed>
      <MiningYield>2</MiningYield>
    </equippedStatOffsets>
    <!-- 移动速度 ×2：ThingDef 没有 equippedStatFactors 字段（写了整条 Def 会加载失败），
         所以用 CompEquipHediff 在装备态挂 Botania_TerrasteelHaste（Hediff 里写 statFactors）。 -->
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="Botania.CompProperties_EquipHediff">
        <hediffDef>Botania_TerrasteelHaste</hediffDef>
      </li>
    </comps>
    <costList>
      <Botania_TerrasteelIngot>1</Botania_TerrasteelIngot>
      <Botania_Livingwood>3</Botania_Livingwood>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_Terrasteel</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>352</displayPriority>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <!-- 攻击数值对齐「传奇玻璃钢战锤」：
         锤头 20 × 玻璃钢钝器 0.9 × 传奇 1.65 ≈ 30；柄 11 × 玻璃钢利器 1.1 × 传奇 1.65 ≈ 20；
         冷却 2.6 × 玻璃钢 0.8 ≈ 2.08 秒。这里写的是**基础值**，成品按自身品质再乘。 -->
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>20</power>
        <cooldownTime>2.08</cooldownTime>
      </li>
      <li>
        <label>pick head</label>
        <labelUsedInLogging>false</labelUsedInLogging>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2.08</cooldownTime>
      </li>
    </tools>
  </ThingDef>

</Defs>
