<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       花瓣（Petal）：植物魔法最基础的材料，8 种颜色。
       全部继承同一抽象基类，只有贴图与文字不同。
       ============================================================ -->

  <ThingDef Name="Botania_PetalBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>0.8</MarketValue>
      <Mass>0.03</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <thingCategories>
      <li>BotaniaPetals</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="Botania_PetalBase">
    <defName>Botania_Petal_White</defName>
    <label>white petal</label>
    <description>A single white petal, still holding a trace of magical energy. Botania crafters grind these into mana powder.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/Petal_White</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
  </ThingDef>

