<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       植物魔法材料：魔力尘、魔力钢锭、活木
       ============================================================ -->

  <ThingDef Name="Botania_MaterialBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <!-- 有 Flammability / DeteriorationRate 的物品必须有耐久度，否则引擎报
         "has >0 DeteriorationRate but can't deteriorate" 与
         "flammable but has no hitpoints (will burn indefinitely)" -->
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>75</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <thingCategories>
      <li>BotaniaItems</li>
    </thingCategories>
  </ThingDef>

  <!-- 魔力尘：花瓣研磨而来，是魔力钢锭等高级材料的中间产物 -->
  <ThingDef ParentName="Botania_MaterialBase">
    <defName>Botania_ManaPowder</defName>
    <label>mana powder</label>
    <description>Petals ground into a fine, faintly glowing dust. It holds mana in a stable form and can be infused into metal.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/ManaPowder</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>3.0</MarketValue>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.05</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
  </ThingDef>

  <!-- 魔力钢锭：可当作建材（金属类）使用 -->
  <ThingDef ParentName="Botania_MaterialBase">
    <defName>Botania_ManasteelIngot</defName>
    <label>manasteel ingot</label>
    <description>Steel infused with mana powder. Lighter and stronger than plain steel, and it hums faintly when touched. Can be used as a building material.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/ManasteelIngot</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>8.5</MarketValue>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>0.4</Mass>
      <Flammability>0.0</Flammability>
      <DeteriorationRate>0.0</DeteriorationRate>
      <StuffPower_Armor_Sharp>1.05</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.55</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.70</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>1.05</SharpDamageMultiplier>
      <BluntDamageMultiplier>1.0</BluntDamageMultiplier>
    </statBases>
    <stuffProps>
      <stuffAdjective>manasteel</stuffAdjective>
      <categories>
        <li>Metallic</li>
      </categories>
      <appearance>Metal</appearance>
      <commonality>0.00</commonality>
      <constructEffect>ConstructMetal</constructEffect>
      <isAirtight>true</isAirtight>
      <color>(118,132,214)</color>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <statFactors>
        <MaxHitPoints>3.3333</MaxHitPoints>
        <WorkToBuild>1.3</WorkToBuild>
        <WorkToMake>1.3</WorkToMake>
        <Beauty>1</Beauty>
        <Flammability>0</Flammability>
      </statFactors>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
  </ThingDef>

  <!-- 活木：可当作建材（木质类）使用，也能当燃料烧 -->
  <ThingDef ParentName="Botania_MaterialBase">
    <defName>Botania_Livingwood</defName>
    <label>livingwood</label>
    <description>Wood that still remembers being a tree. Warm to the touch and slow to burn, it grows into shape rather than being cut. Can be used as a building material or as fuel.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/Livingwood</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>2.2</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.35</Mass>
      <Flammability>0.6</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <StuffPower_Armor_Sharp>0.60</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.60</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.45</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>9</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>5</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>0.45</SharpDamageMultiplier>
      <BluntDamageMultiplier>0.95</BluntDamageMultiplier>
    </statBases>
    <stuffProps>
      <stuffAdjective>livingwood</stuffAdjective>
      <categories>
        <li>Woody</li>
      </categories>
      <appearance>Planks</appearance>
      <commonality>0.00</commonality>
      <constructEffect>ConstructWood</constructEffect>
      <color>(126,88,58)</color>
      <soundImpactBullet>BulletImpact_Wood</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Wood</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Wood</soundMeleeHitBlunt>
      <statOffsets>
        <Beauty>8</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>1.3333</MaxHitPoints>
        <Beauty>2</Beauty>
        <Flammability>0.6</Flammability>
        <WorkToMake>0.7</WorkToMake>
        <WorkToBuild>0.7</WorkToBuild>
      </statFactors>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
  </ThingDef>

  <!-- 活石：石类建材，白雏菊把石砖转化而来，也可用配方合成 -->
  <ThingDef ParentName="Botania_MaterialBase">
    <defName>Botania_Livingrock</defName>
    <label>livingrock</label>
    <description>Stone that grew a thin skin of life over itself. It is warmer than granite to the touch. Can be used as a building material.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/Livingrock</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>2.6</MarketValue>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>0.5</Mass>
      <Flammability>0.0</Flammability>
      <DeteriorationRate>0.0</DeteriorationRate>
      <StuffPower_Armor_Sharp>0.95</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.90</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.55</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>6</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>2</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>0.85</SharpDamageMultiplier>
      <BluntDamageMultiplier>1.05</BluntDamageMultiplier>
    </statBases>
    <stuffProps>
      <stuffAdjective>livingrock</stuffAdjective>
      <categories>
        <li>Stony</li>
      </categories>
      <appearance>Bricks</appearance>
      <commonality>0.00</commonality>
      <color>(126,132,140)</color>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <statOffsets>
        <Beauty>8</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>2</MaxHitPoints>
        <Beauty>1</Beauty>
        <WorkToBuild>1.2</WorkToBuild>
        <WorkToMake>1.2</WorkToMake>
        <Flammability>0</Flammability>
      </statFactors>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
  </ThingDef>

</Defs>
