<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       森林法杖：腰带层工具，装备后给小人两个按钮
         · 绽花：让周围植物立刻长一截
         · 就地转化：把脚边的木头/石块变成活木/活石
       两者都消耗附近魔力池或中继塔的魔力——法杖自己不带魔力。
       ============================================================ -->
  <ThingDef ParentName="ApparelBase">
    <defName>Botania_WandOfTheForest</defName>
    <label>wand of the forest</label>
    <description>A slender livingwood wand capped with a manasteel ring and a drop of glowing sap. It holds no mana of its own; instead it borrows from the nearest pool and reaches for it, letting its bearer coax plants into growing and teach wood and stone to live. Worn on the belt.</description>
    <thingClass>Apparel</thingClass>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/WandOfTheForest/WandOfTheForest</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Normal</tickerType>
    <techLevel>Medieval</techLevel>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>1.2</Mass>
      <MarketValue>120</MarketValue>
      <WorkToMake>3000</WorkToMake>
      <Flammability>0.6</Flammability>
      <EquipDelay>1</EquipDelay>
      <DeteriorationRate>1.0</DeteriorationRate>
    </statBases>
    <costList>
      <Botania_ManasteelIngot>4</Botania_ManasteelIngot>
      <Botania_Livingwood>6</Botania_Livingwood>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_BasicMana</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>310</displayPriority>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
    </recipeMaker>
    <thingCategories>
      <li>BotaniaItems</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
    </apparel>
    <comps>
      <li Class="Botania.CompProperties_Wand">
        <bloomRadius>4</bloomRadius>
        <bloomGrowth>0.25</bloomGrowth>
        <manaPerPlant>20</manaPerPlant>
        <convertRadius>1.5</convertRadius>
        <manaPerConvert>20</manaPerConvert>
        <maxConvertsPerUse>9</maxConvertsPerUse>
        <sourceRadius>8</sourceRadius>
        <rules>
          <li>
            <fromDef>WoodLog</fromDef>
            <toDef>Botania_Livingwood</toDef>
            <count>1</count>
          </li>
          <li>
            <fromCategory>StoneBlocks</fromCategory>
            <toDef>Botania_Livingrock</toDef>
            <count>1</count>
          </li>
        </rules>
      </li>
    </comps>
  </ThingDef>

</Defs>
