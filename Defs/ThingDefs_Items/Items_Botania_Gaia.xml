<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       盖亚装备（终局，Boss 奖励档）
       定位：科技树终点「盖亚」的产物，比泰拉钢再高一档。
       泰拉钢现在是 109%/44%/51%（头盔 65%/26%/31%），盖亚在三项上分别高出
       35 / 16 / 21 个百分点，保持「Boss 奖励明显强于量产装备」的原定意图
       （原计划 130/65 是在泰拉只有 110/55 时定的，泰拉提档后必须同步上移）。
       用料仍然极省：1 泰拉钢锭 + 精灵石英，Boss 装备不该要求海量材料。
       ============================================================ -->

  <!-- 盖亚甲：锐器 144% / 钝器 60% / 热能 72% -->
  <ThingDef ParentName="ApparelBase">
    <defName>Botania_GaiaArmor</defName>
    <label>gaia armor</label>
    <description>Gaia armour is grown from a gaia spirit rather than forged, covering the whole body, and thicker and heavier than terrasteel. Nothing made of ordinary matter cuts through it, and there is no recipe: only the nursery can grow a terrasteel suit into one.

This armour remembers every blow it has taken, and the places it was struck thicken by themselves.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Botania_GaiaArmor/Botania_GaiaArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.00</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>34000</WorkToMake>
      <MaxHitPoints>460</MaxHitPoints>
      <Mass>18</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>1.44</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.60</ArmorRating_Blunt>
      <ArmorRating_Heat>0.72</ArmorRating_Heat>
      <Insulation_Cold>84</Insulation_Cold>
      <Insulation_Heat>14</Insulation_Heat>
      <EquipDelay>5</EquipDelay>
      <MarketValue>4612</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.08</MoveSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <costList>
      <Botania_TerrasteelIngot>1</Botania_TerrasteelIngot>
      <Botania_ElvenQuartz>1</Botania_ElvenQuartz>
      <Botania_PixieDust>1</Botania_PixieDust>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_Gaia</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>360</displayPriority>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
    </recipeMaker>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Botania_GaiaArmor/Botania_GaiaArmor</wornGraphicPath>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Hands</li>
        <li>Legs</li>
        <li>Feet</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
    </apparel>
  </ThingDef>

  <!-- 盖亚头盔：锐器 86% / 钝器 36% / 热能 43%（甲盔比例 0.6，与另两套一致） -->
  <ThingDef ParentName="ApparelBase">
    <defName>Botania_GaiaHelmet</defName>
    <label>gaia helmet</label>
    <description>A helm of gaia plate crowned with living petals that never wilt. It takes a great deal of punishment for the face; it has no recipe either, and comes only from the nursery.

It shuts by itself when danger comes near, and opens again once the shooting stops, like breathing.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Botania_GaiaHelmet/Botania_GaiaHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>22000</WorkToMake>
      <MaxHitPoints>320</MaxHitPoints>
      <Mass>3</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>0.86</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.36</ArmorRating_Blunt>
      <ArmorRating_Heat>0.43</ArmorRating_Heat>
      <Insulation_Cold>6</Insulation_Cold>
      <Insulation_Heat>3</Insulation_Heat>
      <EquipDelay>3</EquipDelay>
      <MarketValue>2767</MarketValue>
    </statBases>
    <thingCategories>
      <li>ArmorHeadgear</li>
    </thingCategories>
    <costList>
      <Botania_TerrasteelIngot>1</Botania_TerrasteelIngot>
      <Botania_PixieDust>1</Botania_PixieDust>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_Gaia</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>361</displayPriority>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
    </recipeMaker>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Botania_GaiaHelmet/Botania_GaiaHelmet</wornGraphicPath>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <parentTagDef>ApparelHead</parentTagDef>
    </apparel>
  </ThingDef>


  <!-- 盖亚核心：Boss 死亡后由尸体分解而成，用于建造「世界之种苗圃」 -->
  <ThingDef ParentName="ResourceBase">
    <defName>Botania_GaiaCore</defName>
    <label>gaia core</label>
    <description>A part that serves one bench and no other: no recipe besides the nursery asks for it. It is also the one thing without which no grove can be planted.

What the heart of the world left behind when it cooled, and now it can be carried away - roots still twitching inside.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/GaiaCore/GaiaCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>1</stackLimit>
    <tradeability>None</tradeability>
    <thingCategories>
      <li>BotaniaItems</li>
    </thingCategories>
    <statBases>
      <MarketValue>3000</MarketValue>
      <Mass>2</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <MaxHitPoints>200</MaxHitPoints>
    </statBases>
  </ThingDef>

</Defs>
