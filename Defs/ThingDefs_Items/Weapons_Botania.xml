    </costList>
    <smeltProducts>
      <Botania_ManasteelIngot>5</Botania_ManasteelIngot>
    </smeltProducts>
    <recipeMaker>
      <researchPrerequisite>Botania_WandForms</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>FueledSmithy</li>
