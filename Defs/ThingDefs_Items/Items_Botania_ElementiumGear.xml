<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       元素装备（Botania_Infusion 研究解锁）
         · 元素剑 / 元素甲 / 元素头盔
         · 护甲有披挂图：6 体型 × 3 方向 = 18 张/件（缺一张就会刷
           "Failed to find any textures at ..._Male"，见第二部分踩坑第 12 条）
         · 全部用元素锭做料，元素锭只能由精灵之门把魔力钢 + 精灵之尘转化出来
       ============================================================ -->

  <!-- 元素剑：26 伤害 / 35% 穿透 / 2.0 秒 -->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>Botania_ElementiumSword</defName>
    <label>elementium sword</label>
    <description>A close-quarters blade of elementium, keen and slow to lose its edge. It carries no trick of its own; the edge is the whole of it.

The pink blade lifts very light, and comes down heavier than it looks.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Botania/ElementiumSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.15,1.15)</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <weaponTags>
      <li>BotaniaMelee</li>
    </weaponTags>
    <statBases>
      <WorkToMake>12000</WorkToMake>
      <Mass>2.2</Mass>
      <MarketValue>3000</MarketValue>
    </statBases>
    <costList>
      <Botania_ElementiumIngot>3</Botania_ElementiumIngot>
      <Botania_Livingwood>2</Botania_Livingwood>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_Infusion</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>345</displayPriority>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.0</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>22</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetration>0.30</armorPenetration>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>26</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetration>0.35</armorPenetration>
      </li>
    </tools>
  </ThingDef>

  <!-- 元素甲：锐器 104% / 钝器 42% / 热能 49%（躯干 + 四肢），披挂外观由 apparel/wornGraphicPath 提供 -->
  <ThingDef ParentName="ApparelBase">
    <defName>Botania_ElementiumArmor</defName>
    <label>elementium armor</label>
    <description>A full suit of elementium plate over a livingwood frame, covering the torso and limbs. It shrugs off cuts far better than it does a hammer, and it costs the wearer a little speed.

It bends first when struck, then slowly springs back to its shape, as though nothing had happened.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Botania_ElementiumArmor/Botania_ElementiumArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.00</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>14000</WorkToMake>
      <MaxHitPoints>260</MaxHitPoints>
      <Mass>11</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>1.04</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
      <ArmorRating_Heat>0.49</ArmorRating_Heat>
      <Insulation_Cold>77</Insulation_Cold>
      <Insulation_Heat>11</Insulation_Heat>
      <EquipDelay>4</EquipDelay>
      <MarketValue>2272</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.10</MoveSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <costList>
      <Botania_ElementiumIngot>4</Botania_ElementiumIngot>
      <Botania_Livingwood>2</Botania_Livingwood>
      <Botania_PixieDust>1</Botania_PixieDust>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_Infusion</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>347</displayPriority>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Botania_ElementiumArmor/Botania_ElementiumArmor</wornGraphicPath>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Hands</li>
        <li>Legs</li>
        <li>Feet</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
    </apparel>
  </ThingDef>

  <!-- 元素头盔：锐器 62% / 钝器 25% / 热能 29% -->
  <ThingDef ParentName="ApparelBase">
    <defName>Botania_ElementiumHelmet</defName>
    <label>elementium helmet</label>
    <description>A helm of elementium covering the whole head, with a visor of quartz. It is lighter than it looks, and it barely gets in the way of seeing.

A blade across it does not ring the way a steel helm does - only a muffled, dull note.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Botania_ElementiumHelmet/Botania_ElementiumHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>9000</WorkToMake>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>2</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>0.62</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Heat>0.29</ArmorRating_Heat>
      <Insulation_Cold>5</Insulation_Cold>
      <Insulation_Heat>2</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <MarketValue>1363</MarketValue>
    </statBases>
    <thingCategories>
      <li>ArmorHeadgear</li>
    </thingCategories>
    <costList>
      <Botania_ElementiumIngot>3</Botania_ElementiumIngot>
      <Botania_PixieDust>1</Botania_PixieDust>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Botania_Infusion</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>348</displayPriority>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Botania_ElementiumHelmet/Botania_ElementiumHelmet</wornGraphicPath>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <parentTagDef>ApparelHead</parentTagDef>
    </apparel>
  </ThingDef>

</Defs>
