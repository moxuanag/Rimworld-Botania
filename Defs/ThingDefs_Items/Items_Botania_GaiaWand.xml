<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    盖亚的小法杖：Boss 拿在手上的「武器」，只有 1 点伤害。
    Boss 的威胁全部来自技能，这把杖只是让它看起来手里有东西、
    并在技能冷却的间隙有最低限度的接触手段。
  -->
  <ThingDef ParentName="BaseMeleeWeapon_Blunt">
    <defName>Botania_GaiaWand</defName>
    <label>gaia wand</label>
    <description>A length of livingwood with a green core set into the tip. It is warm, and it pulses slowly, like something breathing in its sleep.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Botania/GaiaWand</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <weaponTags>
      <li>BotaniaGaiaWand</li>
    </weaponTags>
    <tools>
      <li>
        <label>tap</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>1</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <smeltable>false</smeltable>
    <costList>
      <Botania_Livingwood>8</Botania_Livingwood>
      <Botania_PixieDust>2</Botania_PixieDust>
    </costList>
    <statBases>
      <Mass>1.2</Mass>
      <MarketValue>180</MarketValue>
      <WorkToMake>200</WorkToMake>
    </statBases>
  </ThingDef>

</Defs>
