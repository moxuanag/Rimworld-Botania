<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       精灵材料：精灵门（v0.7）把「魔力 + 普通材料」换成的四种产物。
       梦木 / 精灵石英 / 精灵之尘 是中间产物，元素锭是装备主料。
       数值口径：比同族普通材料贵 40%~100%，但都需要魔力，不是免费升级。
       ============================================================ -->

  <!-- 梦木：活木的高阶版，木质建材 -->
  <ThingDef ParentName="Botania_MaterialBase">
    <defName>Botania_Dreamwood</defName>
    <label>dreamwood</label>
    <description>Livingwood steeped in mana until it darkened to a deep violet. It is lighter than it looks and keeps growing along its own grain, so carpenters say it "remembers" the shape you want. Can be used as a building material.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/Dreamwood</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>3.6</MarketValue>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>0.35</Mass>
      <Flammability>0.45</Flammability>
      <DeteriorationRate>0.4</DeteriorationRate>
      <StuffPower_Armor_Sharp>0.68</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.66</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.50</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>11</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>6</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>0.50</SharpDamageMultiplier>
      <BluntDamageMultiplier>1.0</BluntDamageMultiplier>
    </statBases>
    <stuffProps>
      <stuffAdjective>dreamwood</stuffAdjective>
      <categories>
        <li>Woody</li>
      </categories>
      <appearance>Planks</appearance>
      <commonality>0.00</commonality>
      <constructEffect>ConstructWood</constructEffect>
      <color>(86,60,110)</color>
      <soundImpactBullet>BulletImpact_Wood</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Wood</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Wood</soundMeleeHitBlunt>
      <statOffsets>
        <Beauty>10</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>1.6</MaxHitPoints>
        <Beauty>2</Beauty>
        <Flammability>0.45</Flammability>
        <WorkToMake>0.8</WorkToMake>
        <WorkToBuild>0.8</WorkToBuild>
      </statFactors>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
  </ThingDef>

  <!-- 精灵石英：精灵门的透镜与魔力设施的高级部件，不做建材 -->
  <ThingDef ParentName="Botania_MaterialBase">
    <defName>Botania_ElvenQuartz</defName>
    <label>elven quartz</label>
    <description>Clear crystal grown rather than mined, with light caught inside it like a slow current. Elven gates focus their lenses through it, and finer mana devices will not work without a piece. Too brittle to build with.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/ElvenQuartz</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>7.2</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.25</Mass>
      <Flammability>0.0</Flammability>
      <DeteriorationRate>0.0</DeteriorationRate>
    </statBases>
  </ThingDef>

  <!-- 精灵之尘：元素锭的必要成分 -->
  <ThingDef ParentName="Botania_MaterialBase">
    <defName>Botania_PixieDust</defName>
    <label>pixie dust</label>
    <description>A glittering pink dust that clings to everything it touches and refuses to settle. It is what gives elementium its colour, and the only part of the alloy that cannot be replaced by steel.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/PixieDust</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>6.0</MarketValue>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.03</Mass>
      <Flammability>0.6</Flammability>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
  </ThingDef>

  <!-- 元素锭：元素装备的唯一主料，金属建材 -->
  <ThingDef ParentName="Botania_MaterialBase">
    <defName>Botania_ElementiumIngot</defName>
    <label>elementium ingot</label>
    <description>Manasteel folded with pixie dust until the whole bar flushes pink. It is springy where steel is rigid, which makes it excellent armour and a fair blade. Can be used as a building material.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/ElementiumIngot</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>16.0</MarketValue>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>0.4</Mass>
      <Flammability>0.0</Flammability>
      <DeteriorationRate>0.0</DeteriorationRate>
      <StuffPower_Armor_Sharp>1.15</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.62</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.78</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>4</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>2</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>1.15</SharpDamageMultiplier>
      <BluntDamageMultiplier>1.05</BluntDamageMultiplier>
    </statBases>
    <stuffProps>
      <stuffAdjective>elementium</stuffAdjective>
      <categories>
        <li>Metallic</li>
      </categories>
      <appearance>Metal</appearance>
      <commonality>0.00</commonality>
      <constructEffect>ConstructMetal</constructEffect>
      <isAirtight>true</isAirtight>
      <color>(214,86,155)</color>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <statFactors>
        <MaxHitPoints>4.0</MaxHitPoints>
        <WorkToBuild>1.35</WorkToBuild>
        <WorkToMake>1.35</WorkToMake>
        <Beauty>1</Beauty>
        <Flammability>0</Flammability>
      </statFactors>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
  </ThingDef>

  <!-- ============================================================
       盖亚之魂：E4 研究的科技蓝图。
       注意：这是真物品，不是空引用 —— ResearchProjectDef.Techprint 会扫描所有
       ThingDef 找 CompProperties_Techprint.project == 自己，找不到就报
       "Could not find techprint for research project"。
       ============================================================ -->
  <ThingDef>
    <defName>Botania_GaiaSpirit</defName>
    <label>gaia spirit blueprint</label>
    <description>A sheet of parchment covered in a diagram that no living hand drew: four rays around a ring, half of it still unfinished. Study it at a research bench to work out what the guardians of the old groves were made of.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>1</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <!-- 终局蓝图不该能用钱解决：商人不出售 -->
    <tradeability>None</tradeability>
    <thingCategories>
      <li>BotaniaItems</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Resource/Botania/GaiaSpirit/GaiaSpirit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1200</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.1</Mass>
      <Flammability>0.0</Flammability>
      <DeteriorationRate>0.0</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Techprint">
        <project>Botania_Gaia</project>
      </li>
    </comps>
  </ThingDef>

</Defs>
