<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    盖亚·世界之魂 —— Boss 本体。**不是机械族**。
    种族基于普通生物模板（AnimalThingBase），但按本引擎的 RaceProperties 实际字段写：
      · body=Human          普通部位（头/躯干/四肢）
      · intelligence=Animal  枚举只有 Animal / ToolUser / Humanlike
      · fleshType=Normal     普通血肉，因此必须配 gestationPeriodDays（已给并关闭交配）
      · foodType=None / needsRest=false   不吃不睡
      · lifeStageAges = AnimalAdult        PawnKindDef 的 lifeStages 数量必须与之一致
      · tools 是 **ThingDef 层**字段，不写在 <race> 里
      · 没有 wildness 字段（本引擎 RaceProperties 里不存在）

    数值按 docs/盖亚Boss设计文档.md：
      体型 4 / healthScale 52 / 护甲 锐0.60 钝0.45 热0.50 / 移速 2.0
  -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>Botania_GaiaWorldSoul</defName>
    <label>gaia world-soul</label>
    <description>A mass of root, stone and green light that learned to wear a shape. It moves the way weather moves: slowly, and then all at once.

Its shell drinks a blow before you feel it land, and when the shell goes it lies still for a while - that is the only time it can be hurt.</description>
    <thingClass>Botania.Pawn_GaiaBoss</thingClass>

    <!-- 近战只有 1 点钝伤的「轻触」；威胁全部来自技能 -->
    <tools>
      <li>
        <label>tap</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>1</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>

    <race>
      <body>Human</body>
      <baseBodySize>4</baseBodySize>
      <baseHealthScale>52</baseHealthScale>
      <!-- ToolUser 而不是 Animal：RaceProperties.Animal = !ToolUser && IsFlesh，
           用 Animal 会被当成野生动物（出现驯服/狩猎按钮） -->
      <intelligence>ToolUser</intelligence>
      <!-- 自定义思考树：追击/站定，不游荡 -->
      <thinkTreeMain>Botania_Gaia</thinkTreeMain>
      <thinkTreeConstant>AnimalConstant</thinkTreeConstant>
      <fleshType>Normal</fleshType>
      <foodType>None</foodType>
      <needsRest>false</needsRest>
      <trainability>None</trainability>
      <petness>0</petness>
      <gestationPeriodDays>1</gestationPeriodDays>
      <disableMating>true</disableMating>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>

    <statBases>
      <Flammability>0.0</Flammability>
      <MoveSpeed>2.0</MoveSpeed>
      <ArmorRating_Sharp>0.60</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
      <ArmorRating_Heat>0.50</ArmorRating_Heat>
      <MarketValue>20000</MarketValue>
      <ComfyTemperatureMin>-200</ComfyTemperatureMin>
      <ComfyTemperatureMax>200</ComfyTemperatureMax>
    </statBases>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>Botania_GaiaWorldSoul</defName>
    <label>gaia world-soul</label>
    <race>Botania_GaiaWorldSoul</race>
    <combatPower>900</combatPower>
    <!-- Boss 只会被打死，不会痛晕倒地 -->
    <ignoresPainShock>true</ignoresPainShock>
    <!-- 自有美术：三向（南/东/北），西向由引擎镜像东向 -->
    <lifeStages Inherit="False">
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Botania/GaiaWorldSoul</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>4</drawSize>
          <shadowData>
            <volume>(1.1, 1.5, 1.1)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
