<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 携带森林法杖时挂在小人身上的「魔力储备」。
       severity 直接就是杖内的绝对魔力值（上限 500），
       所以在健康面板里既能看到数字，也能看到底部那条进度条。 -->
  <HediffDef>
    <defName>Botania_WandMana</defName>
    <label>wand mana</label>
    <description>The mana held inside the wand of the forest in this person's hands.</description>
    <hediffClass>Botania.Hediff_WandMana</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>500</maxSeverity>
    <comps>
      <!-- 持杖时在技能栏里显示一根只读魔力条（参照 CE 的弹药显示） -->
      <li Class="Botania.HediffComp_ManaReadout" />
    </comps>
  </HediffDef>

</Defs>
