<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       神秘花（Mystic Flower）：花瓣的唯一来源。
       野生 8 色生成在各生物群系（见 Patches\Botania_WildPlants.xml），
       不可人工播种；收获后植株保留并重新生长（harvestAfterGrowth=0.35）。
       唯一可播种的是末尾的人工栽培品种 Botania_MysticFlower_WhiteGarden
       （研究「神秘花卉」后可播种，收割即销毁）。
       ============================================================ -->

  <ThingDef ParentName="PlantBase" Name="Botania_MysticFlowerBase" Abstract="True">
    <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <Beauty>6</Beauty>
      <BeautyOutdoors>8</BeautyOutdoors>
      <Nutrition>0.05</Nutrition>
      <Flammability>0.8</Flammability>
    </statBases>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <ingestible>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
    </ingestible>
    <plant>
      <dieIfLeafless>true</dieIfLeafless>
      <growDays>2.5</growDays>
      <fertilitySensitivity>0.7</fertilitySensitivity>
      <harvestTag>Standard</harvestTag>
      <harvestYield>1</harvestYield>
      <harvestWork>200</harvestWork>
      <harvestMinGrowth>0.6</harvestMinGrowth>
      <harvestAfterGrowth>0.35</harvestAfterGrowth>
      <harvestFailable>false</harvestFailable>
      <sowWork>170</sowWork>
      <sowMinSkill>2</sowMinSkill>
      <topWindExposure>0.1</topWindExposure>
      <visualSizeRange>0.5~1.05</visualSizeRange>
      <wildOrder>1</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_White</defName>
    <label>mystic flower (white)</label>
    <description>She is the first one anyone named. A wild flower, and white petals can only be taken from her; she cannot be sown and only grows where she chooses.

A small cluster of white in a place nobody tends, and the whole patch nods when the wind passes.</description>
    <statBases>
      <MarketValue>3</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_White</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_White</harvestedThingDef>
    </plant>
  </ThingDef>

  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_Orange</defName>
    <label>mystic flower (orange)</label>
    <description>She does not much care where she comes up. A wild flower, and orange petals can only be taken from her; she cannot be sown and only grows where she chooses.

Its colour was mixed rather than grown, so it looks more like a sample card than a real flower.</description>
    <statBases>
      <MarketValue>3</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_Orange</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_Orange</harvestedThingDef>
    </plant>
  </ThingDef>



  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_Yellow</defName>
    <label>mystic flower (yellow)</label>
    <description>She opens first and closes last. A wild flower, and yellow petals can only be taken from her; she cannot be sown and only grows where she chooses.

A clean, decisive yellow, as if someone had cut a thin shape out of the sunlight.</description>
    <statBases>
      <MarketValue>3</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_Yellow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_Yellow</harvestedThingDef>
    </plant>
  </ThingDef>





  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_Cyan</defName>
    <label>mystic flower (cyan)</label>
    <description>She grows on the shaded side and perks up on grey days. A wild flower, and cyan petals can only be taken from her; she cannot be sown and only grows where she chooses.

Cool to look at, like the bit of sky still hanging on the leaves after the rain stops.</description>
    <statBases>
      <MarketValue>3</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_Cyan</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_Cyan</harvestedThingDef>
    </plant>
  </ThingDef>

  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_Purple</defName>
    <label>mystic flower (purple)</label>
    <description>She opens slowly, slowly enough that she looks broken. A wild flower, and purple petals can only be taken from her; she cannot be sown and only grows where she chooses.

Too deep for its own good, as if a scrap of night had been sewn into the flower.</description>
    <statBases>
      <MarketValue>3</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_Purple</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_Purple</harvestedThingDef>
    </plant>
  </ThingDef>



  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_Green</defName>
    <label>mystic flower (green)</label>
    <description>She is the one seen most often by the roadside. A wild flower, and green petals can only be taken from her; she cannot be sown and only grows where she chooses.

A little wild, and now at last it is really growing in the soil.</description>
    <statBases>
      <MarketValue>3</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_Green</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_Green</harvestedThingDef>
    </plant>
  </ThingDef>

  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_Red</defName>
    <label>mystic flower (red)</label>
    <description>She is the loudest thing in bloom, visible from far off. A wild flower, and red petals can only be taken from her; she cannot be sown and only grows where she chooses.

Red like a sentence left unfinished, caught on the edge of the petal.</description>
    <statBases>
      <MarketValue>3</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_Red</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_Red</harvestedThingDef>
    </plant>
  </ThingDef>

  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_Black</defName>
    <label>mystic flower (black)</label>
    <description>She keeps out of the light, deep in the woods. A wild flower, and black petals can only be taken from her; she cannot be sown and only grows where she chooses.

So black that its edges shine; look long enough and you will think it is slowly closing.</description>
    <statBases>
      <MarketValue>3</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_Black</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_Black</harvestedThingDef>
    </plant>
  </ThingDef>

  <!-- ============================================================
       高产白神秘花（人工栽培品种）：研究「神秘花卉」后可播种，
       单株收获 5 片白花瓣；harvestAfterGrowth=0 表示收割即销毁、需重新播种，
       不像野生神秘花那样收割后复生。野生生成表（Patches\Botania_WildPlants.xml）
       只挂了 Botania_MysticFlower_White，且本 def 没有 wildBiomes，
       所以本 def 不会野生生成；wildOrder 沿用基类的 1。
       ============================================================ -->
  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_WhiteGarden</defName>
    <label>cultivated white mystic flower</label>
    <description>She is the one brought in from the wild. Plant her seed in soil and she comes up with the season, no longer waiting for someone to wander past.

A flower used to being waited on, she opens more evenly than the ones in the wild - and she is greedier.</description>
    <statBases>
      <MarketValue>3</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_White</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_White</harvestedThingDef>
      <harvestYield>5</harvestYield>
      <harvestAfterGrowth>0</harvestAfterGrowth>
      <growDays>2.5</growDays>
      <sowWork>170</sowWork>
      <sowMinSkill>2</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>Botania_Flowers</li>
      </sowResearchPrerequisites>
    </plant>
  </ThingDef>

</Defs>
