<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       神秘花（Mystic Flower）：花瓣的唯一来源。
       野生生成在各生物群系（见 Patches\Botania_WildPlants.xml），
       也可在研究「神秘花卉」后播种。
       收获后植株保留并重新生长（harvestAfterGrowth），是可持续的花田作物。
       ============================================================ -->

  <ThingDef ParentName="PlantBase" Name="Botania_MysticFlowerBase" Abstract="True">
    <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <Beauty>6</Beauty>
      <BeautyOutdoors>8</BeautyOutdoors>
      <Nutrition>0.05</Nutrition>
      <Flammability>0.8</Flammability>
    </statBases>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <ingestible>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
    </ingestible>
    <plant>
      <dieIfLeafless>true</dieIfLeafless>
      <growDays>2.5</growDays>
      <fertilitySensitivity>0.7</fertilitySensitivity>
      <harvestTag>Standard</harvestTag>
      <harvestYield>4</harvestYield>
      <harvestWork>200</harvestWork>
      <harvestMinGrowth>0.6</harvestMinGrowth>
      <harvestAfterGrowth>0.35</harvestAfterGrowth>
      <harvestFailable>false</harvestFailable>
      <sowWork>170</sowWork>
      <sowMinSkill>2</sowMinSkill>
      <sowResearchPrerequisites>
        <li>Botania_Flowers</li>
      </sowResearchPrerequisites>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <topWindExposure>0.1</topWindExposure>
      <visualSizeRange>0.5~1.05</visualSizeRange>
      <wildOrder>1</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

  <ThingDef ParentName="Botania_MysticFlowerBase">
    <defName>Botania_MysticFlower_White</defName>
    <label>mystic flower (white)</label>
    <description>A small flower whose white petals still hold a faint trace of mana. Harvest it for petals; the plant regrows if you leave the roots alone.</description>
    <graphicData>
      <texPath>Things/Plant/Botania/MysticFlower_White</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <plant>
      <harvestedThingDef>Botania_Petal_White</harvestedThingDef>
    </plant>
  </ThingDef>

