<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       配方：花瓣 → 魔力尘 → 魔力钢锭；木头 → 活木
       全部由 Botania_BasicMana 研究解锁
       ============================================================ -->

  <RecipeDef>
    <defName>Botania_MakeManaPowder</defName>
    <label>grind mana powder</label>
    <description>Grind petals into mana powder, the base material of all Botania crafting.</description>
    <jobString>Grinding mana powder.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workAmount>1200</workAmount>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>BotaniaPetals</li>
          </categories>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>BotaniaPetals</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <Botania_ManaPowder>1</Botania_ManaPowder>
    </products>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>Botania_BasicMana</researchPrerequisite>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>FueledSmithy</li>
      <li>ElectricSmithy</li>
    </recipeUsers>
  </RecipeDef>


  <!-- 活石：白雏菊也能自动转化，这个配方是不方便建花时的替代手段 -->

  <RecipeDef>
    <defName>Botania_MakeManasteel</defName>    <label>forge manasteel</label>
    <description>Fold mana powder into molten steel. The result is lighter than steel and holds an enchantment that never fades.</description>
    <jobString>Forging manasteel.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>2400</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Botania_ManaPowder</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Botania_ManaPowder</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Botania_ManasteelIngot>1</Botania_ManasteelIngot>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>Botania_Manasteel</researchPrerequisite>
    <recipeUsers>
      <li>FueledSmithy</li>
      <li>ElectricSmithy</li>
    </recipeUsers>
  </RecipeDef>


  <!-- 染色：白花瓣 + 原版染料 → 橙色花瓣（0.9.2 起野外只有白色神秘花） -->
  <RecipeDef>
    <defName>Botania_DyePetal_Orange</defName>
    <label>dye orange petals</label>
    <description>Soak white mystic petals in dye to coax a different colour out of them.</description>
    <jobString>Dyeing petals.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workAmount>600</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Botania_Petal_White</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Dye</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <products>
      <Botania_Petal_Orange>1</Botania_Petal_Orange>
    </products>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>Botania_BasicMana</researchPrerequisite>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>HandTailoringBench</li>
      <li>ElectricTailoringBench</li>
    </recipeUsers>
  </RecipeDef>

