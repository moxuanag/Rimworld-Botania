<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 森林法杖的两个法术。结构与原版灵能技能一致
       （参考 Data/Core/Defs/AbilityDefs/AbilityDefs.xml 的 PsycastBase，
        以及 Data/Royalty 的 AgonyPulse）：
       - abilityClass 指向自定义 Ability 子类（原版 Psycast 也是这么做的）；
       - verbProperties 用原版 Verb_CastAbility，**不自定义 Verb**
         （自定义 Verb 拿不到 ability 引用，会让 OnGUI 每帧 NRE、UI 全丢）；
       - 作用半径写在 statBases 的 Ability_EffectRadius，引擎据此在鼠标所在格画圈；
       - 魔力不在这里扣，费用由法杖的 CompWand 结算。
       注意：abilityClass 里的类名不能改，存档按类名保存 Ability 实例。 -->
  <AbilityDef>
    <defName>Botania_SpellBloom</defName>
    <label>bloom</label>
    <description>Pour mana into the plants around the chosen spot and force them to grow. Costs 20 mana per plant.</description>
    <iconPath>UI/Icons/Botania/Bloom</iconPath>
    <abilityClass>Botania.Ability_WandBloom</abilityClass>
    <hotKey>Misc11</hotKey>
    <cooldownTicksRange>60</cooldownTicksRange>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <showOnCharacterCard>false</showOnCharacterCard>
    <statBases>
      <!-- 作用半径，与 CompProperties_Wand 的 bloomRadius 保持一致 -->
      <Ability_EffectRadius>4</Ability_EffectRadius>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>6</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <soundCast>PsycastPsychicEffect</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
  </AbilityDef>

  <AbilityDef>
    <defName>Botania_SpellConvert</defName>
    <label>transmute in place</label>
    <description>Teach the wood and stone around the chosen spot to live. Costs 20 mana per stack.</description>
    <iconPath>UI/Icons/Botania/Transfer</iconPath>
    <abilityClass>Botania.Ability_WandConvert</abilityClass>
    <hotKey>Misc12</hotKey>
    <cooldownTicksRange>60</cooldownTicksRange>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <showOnCharacterCard>false</showOnCharacterCard>
    <statBases>
      <!-- 作用半径，与 CompProperties_Wand 的 convertRadius 保持一致 -->
      <Ability_EffectRadius>1.5</Ability_EffectRadius>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>6</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <soundCast>PsycastPsychicEffect</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
  </AbilityDef>

  <!-- 泰拉刃的剑气：装备泰拉刃时由 MapComponent_WandState 授予。
       一条 12 格直线，伤害 30 递减到 10，冷却 8 秒（cooldownTicksRange 480）。
       魔力不在这里扣：Ability_TerraWave 会从 8 格内最近的魔力源抽 400。 -->
  <AbilityDef>
    <defName>Botania_TerraWave</defName>
    <label>terrasteel wave</label>
    <description>Swing the blade and let the metal remember the arc. A line of force runs twelve cells in front of you, cutting for 30 at the first step and fading to 10 at the far end. Costs 400 mana from a nearby pool.</description>
    <iconPath>UI/Icons/Botania/TerraWave</iconPath>
    <abilityClass>Botania.Ability_TerraWave</abilityClass>
    <hotKey>Misc13</hotKey>
    <cooldownTicksRange>480</cooldownTicksRange>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <showOnCharacterCard>false</showOnCharacterCard>
    <statBases>
      <Ability_EffectRadius>1</Ability_EffectRadius>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>12</range>
      <warmupTime>0.6</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <soundCast>PsycastPsychicEffect</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
  </AbilityDef>

</Defs>
