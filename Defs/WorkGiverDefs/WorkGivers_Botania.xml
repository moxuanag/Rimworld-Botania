<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    给泰拉凝聚台送料：归「搬运」工作，和「运材料给蓝图/框架」同一类。
    派出去的是原版 JobDefOf.HaulToCell，没有自定义 JobDriver。
    优先级 8：比运材料给蓝图（9）稍微靠后一点，别抢工地供料。
  -->
  <WorkGiverDef>
    <defName>BotaniaDeliverToTerraAltar</defName>
    <label>deliver materials to terra altar</label>
    <giverClass>Botania.WorkGiver_TerraAltarDeliver</giverClass>
    <workType>Hauling</workType>
    <priorityInType>8</priorityInType>
    <verb>deliver to</verb>
    <gerund>delivering to</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <nonColonistsCanDo>true</nonColonistsCanDo>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>


  <!--
    调查盖亚传送门：归「研究」工作类型，和原版研究同一优先级面板。
    传送门处于「待调查」时才会派活；进度按小人的研究速度计算。
  -->
  <WorkGiverDef>
    <defName>BotaniaInvestigateGaiaPortal</defName>
    <label>investigate gaia portal</label>
    <giverClass>Botania.WorkGiver_GaiaInvestigation</giverClass>
    <workType>Research</workType>
    <priorityInType>10</priorityInType>
    <verb>investigate</verb>
    <gerund>investigating</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
