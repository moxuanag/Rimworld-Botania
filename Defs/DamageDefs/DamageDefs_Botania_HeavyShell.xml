<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       重型迫击炮花的伤害与弹药。

       用户定案（2026-11-24，2026-11-25 平衡调整）：
         · 射程 = 原版迫击炮（全图 500 / 最小 20）
         · 伤害 = 原版「反物质弹头（antigrain warhead）」的一半
             反物质：BombSuper 伤害 550 / 爆炸半径 14.9 / 炸后留火灾
             我们  ：伤害 275 / 爆炸半径 9.5（0.9.2 由 7.45 放大，用户指定）
         · 攻击间隔 75 秒（预热 4s + 冷却 75s）
       ============================================================ -->

  <!-- 伤害 = BombSuper 的一半。继承 BombSuper 以保留 Shredded/Crack 等原版受伤语义，
       同时显式写出 hediff，避免本引擎「自定义 DamageDef 必须带 hediff」的坑。 -->
  <DamageDef>
    <defName>Botania_HeavyManaBomb</defName>
    <label>summoned meteor</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <isExplosive>true</isExplosive>
    <impactSoundType>Blunt</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <!-- 数值 = 反物质弹头（BombSuper：550 伤害 / 2.0 停阻 / 1.30 穿甲）的一半伤害，
         其余属性照抄 BombSuper/Bomb，保证「爆炸 + 撕裂伤 + 破墙」语义与原版一致。 -->
    <defaultDamage>275</defaultDamage>
    <defaultStoppingPower>2.0</defaultStoppingPower>
    <defaultArmorPenetration>1.30</defaultArmorPenetration>
    <minDamageToFragment>15</minDamageToFragment>
    <buildingDamageFactorImpassable>4</buildingDamageFactorImpassable>
    <buildingDamageFactorPassable>2</buildingDamageFactorPassable>
    <plantDamageFactor>4</plantDamageFactor>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <hediff>Shredded</hediff>
    <hediffSolid>Crack</hediffSolid>
    <corpseDamageFactor>0.5</corpseDamageFactor>
    <explosionAffectOutsidePartsOnly>false</explosionAffectOutsidePartsOnly>
    <explosionHeatEnergyPerCell>5</explosionHeatEnergyPerCell>
    <explosionCellFleck>BlastDry</explosionCellFleck>
    <explosionColorCenter>(1, 0.5, 0.3)</explosionColorCenter>
    <explosionColorEdge>(0.6, 0.5, 0.4)</explosionColorEdge>
    <soundExplosion>Explosion_Bomb</soundExplosion>
    <combatLogRules>Damage_Bomb</combatLogRules>
    <deathMessage>{0} has been erased by a mana warhead.</deathMessage>
  </DamageDef>

  <!-- 投射物：高抛、大范围、留燃烧（与反物质弹同款表现，半径减半） -->
  <!-- 弹体：一出膛就变成「从天上落下的陨石」（复用原版 Skyfaller 机制）。
       伤害与爆炸范围写在下面的 Botania_MeteorIncoming 的 <skyfaller> 块里，
       这里的 projectile 只保留命中判定所需的字段。 -->
  <ThingDef ParentName="BaseBullet">
    <defName>Botania_Bullet_HeavyManaShell</defName>
    <label>summoned meteor</label>
    <graphicData>
      <texPath>Things/Projectile/Botania/ManaMeteor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>Botania.Projectile_ManaMeteor</thingClass>
    <projectile>
      <damageDef>Botania_HeavyManaBomb</damageDef>
      <speed>120</speed>
      <!-- 弹体瞬间转化为陨石，不会自己爆炸；保留最小半径仅为兜底 -->
      <explosionRadius>0</explosionRadius>
      <flyOverhead>true</flyOverhead>
      <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
      <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
      <soundAmbient>MortarRound_Ambient</soundAmbient>
    </projectile>
  </ThingDef>

  <!-- 陨石本体：直接继承原版 SkyfallerBase（陨石事件用的那套），
       爆炸半径 9.5 / 伤害 Botania_HeavyManaBomb(275) = 反物质弹头的一半伤害（半径见上方定案）。
       观感（下落弧线、投影、落地扬尘、震屏）全部由原版 Skyfaller 负责。 -->
  <ThingDef ParentName="SkyfallerBase">
    <defName>Botania_MeteorIncoming</defName>
    <label>summoned meteor (incoming)</label>
    <size>(2, 2)</size>
    <graphicData>
      <texPath>Things/Skyfaller/Botania/Meteor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(10, 10)</drawSize>
    </graphicData>
    <skyfaller>
      <shadowSize>(3, 3)</shadowSize>
      <explosionRadius>9.5</explosionRadius>
      <explosionDamage>Botania_HeavyManaBomb</explosionDamage>
      <explosionDamageFactor>1</explosionDamageFactor>
      <cameraShake>0.5</cameraShake>
      <rotateGraphicTowardsDirection>true</rotateGraphicTowardsDirection>
      <speed>0.7</speed>
      <ticksToImpactRange>180~240</ticksToImpactRange>
      <impactSound>Explosion_GiantBomb</impactSound>
      <floatingSound>MortarRound_Ambient</floatingSound>
    </skyfaller>
  </ThingDef>

</Defs>
