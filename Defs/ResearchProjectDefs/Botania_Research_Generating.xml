<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       产能花段（2026-11-25 第十一次布局）：10 个节点，分类卡在 x=0。

       花之间横向 0.9（卡 0，花 0.9 与 1.8）；同档两行花纵向 0.6（2.8/3.4 与 5.6/6.2）；
       基础末行到进阶 0.8（3.4 到 4.2），进阶到终阶 1.4（4.2 到 5.6）；
       分类卡在它那两行花正中（+0.3）。

         y=3.1  x=x=0    Botania_GenBasic           基础产能花（分类卡）
         y=2.8  x=x=0.9  Botania_EndoflameStudy     火红莲
         y=2.8  x=x=1.8  Botania_BitterBloomStudy   苦丽花
         y=3.4  x=x=0.9  Botania_PassiveGenerating  太阳花
         y=3.4  x=x=1.8  Botania_NightshadeStudy    夜颠茄
         y=4.5  x=x=0    Botania_GenAdvanced        进阶产能花（分类卡）
         y=4.2  x=x=0.9  Botania_RosaArcanaStudy    阿卡纳蔷薇
         y=5.9  x=x=0    Botania_GenUltimate        终极产能花（分类卡）
         y=5.6  x=x=0.9  Botania_GeneratingII       炉心蕙
         y=6.2  x=x=0.9  Botania_LifeOrchidStudy    启命英

       前置结构（树上的可见线）：
         GenBasic     <- Garden
         EndoflameStudy / BitterBloomStudy   <- GenBasic
         PassiveGenerating / NightshadeStudy <- GenBasic（并入基础层，不再单列被动层）
         GenAdvanced  <- GenBasic（隐藏 Terrasteel）
         GenUltimate  <- GenAdvanced（隐藏 Gaia）
         RosaArcanaStudy                 <- GenAdvanced
         GeneratingII / LifeOrchidStudy  <- GenUltimate

       描述里的数值一律来自 ThingDef 的 comps 字段与 Source/*.cs 的实现，
       完整推导见 docs/玩法指南.md。
       ============================================================ -->

  <!-- ===== x=0 y=3.1 基础产能花：三类产能花的分工与共同的取魔前提 ===== -->

  <ResearchProjectDef>
    <defName>Botania_GenBasic</defName>
    <label>basic generating flowers</label>
    <description>Generating flowers are where a colony's mana comes from. This card attaches no defs itself; it opens the endoflame, bitter bloom, daybloom and nightshade cards.</description>
    <baseCost>900</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Garden</li>
    </prerequisites>
    <researchViewX>0.00</researchViewX>
    <researchViewY>3.10</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=0 y=4.5 进阶产能花总览：烧料 / 扫场，接泰拉钢 ===== -->

  <ResearchProjectDef>
    <defName>Botania_GenAdvanced</defName>
    <label>advanced generating flowers</label>
    <description>The advanced tier of generating flowers. This card attaches no defs itself; it opens the rosa arcana and the ultimate generating flowers cards.</description>
    <baseCost>800</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_GenBasic</li>
    </prerequisites>
    <hiddenPrerequisites>
      <li>Botania_Terrasteel</li>
    </hiddenPrerequisites>
    <researchViewX>0.00</researchViewX>
    <researchViewY>4.50</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 火红莲：烧燃料换稳定 30 魔力/秒，没池子不烧料（x=0.9, y=2.8） ===== -->

  <ResearchProjectDef>
    <defName>Botania_EndoflameStudy</defName>
    <label>endoflame</label>
    <description>A generating flower that eats fuel instead of light. Unlocks the endoflame, which burns wood, livingwood or chemfuel, and stops without a mana network.</description>
    <baseCost>700</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_GenBasic</li>
    </prerequisites>
    <researchViewX>0.90</researchViewX>
    <researchViewY>2.80</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 苦丽花：8 格内按技能经验 ×10 计费，单次封顶 400（x=1.8, y=2.8） ===== -->

  <ResearchProjectDef>
    <defName>Botania_BitterBloomStudy</defName>
    <label>bitter bloom</label>
    <description>A generating flower billed to other people's labour. Unlocks the bitter bloom, which makes mana while pawns nearby work, and charges those pawns for it.</description>
    <baseCost>850</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_GenBasic</li>
    </prerequisites>
    <researchViewX>1.80</researchViewX>
    <researchViewY>2.80</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=0 y=5.9 终极产能花总览：热机与生命游戏，接盖亚 ===== -->

  <ResearchProjectDef>
    <defName>Botania_GenUltimate</defName>
    <label>ultimate generating flowers</label>
    <description>The last tier of generating flowers. This card attaches no defs itself; it opens the furnace orchid and the life orchid cards.</description>
    <baseCost>1200</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_GenAdvanced</li>
    </prerequisites>
    <hiddenPrerequisites>
      <li>Botania_Gaia</li>
    </hiddenPrerequisites>
    <researchViewX>0.00</researchViewX>
    <researchViewY>5.90</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 太阳花：白天零成本被动产魔，15 天枯萎（x=0.9, y=3.4） ===== -->

  <ResearchProjectDef>
    <defName>Botania_PassiveGenerating</defName>
    <label>daybloom</label>
    <description>A passive flower that asks only for daylight. Unlocks the daybloom, which needs no fuel or pawn and stops at night, under an eclipse or under ash.</description>
    <baseCost>400</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_GenBasic</li>
    </prerequisites>
    <researchViewX>0.90</researchViewX>
    <researchViewY>3.40</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 夜颠茄：夜间被动产魔，产量是太阳花的一半（x=1.8, y=3.4） ===== -->

  <ResearchProjectDef>
    <defName>Botania_NightshadeStudy</defName>
    <label>nightshade</label>
    <description>The night-time counterpart of the daybloom. Unlocks the nightshade, which makes mana only in darkness, and less of it than a daybloom.</description>
    <baseCost>400</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_GenBasic</li>
    </prerequisites>
    <researchViewX>1.80</researchViewX>
    <researchViewY>3.40</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 阿卡纳蔷薇：8 格内每个还在学习的小人 6 魔力/秒（x=0.9, y=4.2） ===== -->

  <ResearchProjectDef>
    <defName>Botania_RosaArcanaStudy</defName>
    <label>rosa arcana</label>
    <description>Harvest what a mind has not finished learning. Unlocks the rosa arcana, which makes more mana the more pawns nearby are still learning.</description>
    <baseCost>1100</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_GenAdvanced</li>
    </prerequisites>
    <researchViewX>0.90</researchViewX>
    <researchViewY>4.20</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 炉心蕙：密闭高温房间 + 燃料，0.2 × (T−40) × √A，上限 60（x=0.9, y=5.6） ===== -->

  <ResearchProjectDef>
    <defName>Botania_GeneratingII</defName>
    <label>furnace orchid</label>
    <description>Turn the heat of a sealed room into mana. Unlocks the furnace orchid, which burns fuel in a roofed, hot room and damages itself when it overheats.</description>
    <baseCost>1500</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_GenUltimate</li>
    </prerequisites>
    <researchViewX>0.90</researchViewX>
    <researchViewY>5.60</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 启命英：11×11 肉床上的生命游戏，按变化格 ×40 计价，单代上限 900（x=0.9, y=6.2） ===== -->

  <ResearchProjectDef>
    <defName>Botania_LifeOrchidStudy</defName>
    <label>life orchid</label>
    <description>A generating flower that is really a game. Unlocks the life orchid, which runs a colony of cells on a flesh bed and pays only for change.</description>
    <baseCost>2500</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_GenUltimate</li>
    </prerequisites>
    <researchViewX>0.90</researchViewX>
    <researchViewY>6.20</researchViewY>
  </ResearchProjectDef>

</Defs>
