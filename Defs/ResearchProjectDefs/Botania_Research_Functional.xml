<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       功能花段（0.9.3 第十二次布局）：7 个节点，分类卡在 x=3.7。

       花之间横向 0.9（卡 3.7，花 4.6；最右列不再有节点，明心莲已移到 4.6）；
       同档两行花纵向 0.6（2.8/3.4 与 4.2/4.8）；
       基础末行到进阶 0.8（3.4 到 4.2），进阶到终阶 1.4（4.2 到 5.6）；
       分类卡在它那几行花正中（+0.3）。

         y=3.1  x=x=3.7    Botania_FunctionalI          基础功能花（分类卡）
         y=2.8  x=x=4.6  Botania_BlightEaterStudy     噬草花
         y=3.4  x=x=4.6  Botania_FertilityFlowerStudy 丰饶花（0.9.3 新增）
         y=4.5  x=x=3.7    Botania_FuncAdvanced         进阶功能花（分类卡）
         y=4.2  x=x=4.6  Botania_StormBloomStudy      电暴花
         y=4.8  x=x=4.6  Botania_ClearMindLotusStudy  明心莲（0.9.3 从 5.5/2.8 移来）
         y=5.9  x=x=3.7    Botania_FuncUltimate         终极功能花（分类卡）

       前置结构（树上的可见线）：
         FunctionalI        <- Garden
         BlightEaterStudy / FertilityFlowerStudy <- FunctionalI
         FuncAdvanced       <- FunctionalI（隐藏 Terrasteel）
         StormBloomStudy / ClearMindLotusStudy   <- FuncAdvanced
         FuncUltimate       <- FuncAdvanced（隐藏 Gaia）

       描述里的数值一律来自 ThingDef 的 comps 字段与 Source/*.cs 的实现，
       完整推导见 docs/玩法指南.md。
       ============================================================ -->

  <!-- ===== x=3.7 y=3.1 基础功能花：功能花的分工与共同的「付费 + 联网」前提 ===== -->

  <ResearchProjectDef>
    <defName>Botania_FunctionalI</defName>
    <label>basic functional flowers</label>
    <description>Functional flowers spend mana on labour instead of making it. This card attaches no defs itself; it opens the blight eater and fertility flower cards.</description>
    <baseCost>200</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Garden</li>
    </prerequisites>
    <researchViewX>3.70</researchViewX>
    <researchViewY>3.10</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=3.7 y=4.5 进阶功能花总览：按秒结算、按破损取目标的高价层 ===== -->

  <ResearchProjectDef>
    <defName>Botania_FuncAdvanced</defName>
    <label>advanced functional flowers</label>
    <description>The advanced tier of functional flowers. This card attaches no defs itself; it opens the storm bloom and the ultimate functional flowers cards.</description>
    <baseCost>800</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_FunctionalI</li>
    </prerequisites>
    <hiddenPrerequisites>
      <li>Botania_Terrasteel</li>
    </hiddenPrerequisites>
    <researchViewX>3.70</researchViewX>
    <researchViewY>4.50</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 噬草花：6 格内吃枯萎病作物，3 秒一株 1500 魔力（x=4.6, y=2.8） ===== -->

  <ResearchProjectDef>
    <defName>Botania_BlightEaterStudy</defName>
    <label>blight eater</label>
    <description>A flower that eats blight instead of making it. Unlocks the blight eater, which swallows blighted crops nearby and turns them into mana.</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_FunctionalI</li>
    </prerequisites>
    <researchViewX>4.60</researchViewX>
    <researchViewY>2.80</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 丰饶花：半径 4，自选作物播种 / 收割 / 加速成熟，绿花瓣当种子（x=4.6, y=3.4） ===== -->

  <ResearchProjectDef>
    <defName>Botania_FertilityFlowerStudy</defName>
    <label>fertility flower</label>
    <description>Let a flower do the planting. Unlocks the fertility flower, which sows the crop you choose into the bare tiles around it and harvests what ripens, leaving the yield at its feet.</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_FunctionalI</li>
    </prerequisites>
    <researchViewX>4.60</researchViewX>
    <researchViewY>3.40</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 明心莲：半径 8，只挡心灵干扰；按受影响人数每人 20 魔力 / 60 tick（x=4.6, y=4.8） ===== -->

  <ResearchProjectDef>
    <defName>Botania_ClearMindLotusStudy</defName>
    <label>clear-mind lotus</label>
    <description>A lotus that pushes a psychic drone out of every head in range. Unlocks the clear-mind lotus, which charges nothing when there is no drone.</description>
    <baseCost>1200</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_FuncAdvanced</li>
    </prerequisites>
    <researchViewX>4.60</researchViewX>
    <researchViewY>4.80</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=3.7 y=5.9 终极功能花总览：接盖亚，按千计结算 ===== -->

  <ResearchProjectDef>
    <defName>Botania_FuncUltimate</defName>
    <label>ultimate functional flowers</label>
    <description>The end tier of functional flowers. This card attaches no defs itself; nothing hangs under it yet and it is kept as a mount point.</description>
    <baseCost>1200</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_FuncAdvanced</li>
    </prerequisites>
    <hiddenPrerequisites>
      <li>Botania_Gaia</li>
    </hiddenPrerequisites>
    <researchViewX>3.70</researchViewX>
    <researchViewY>5.90</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 电暴花：捡电网短路的漏，15 格吸收、缓存 12 瓦日（x=4.6, y=4.2） ===== -->

  <ResearchProjectDef>
    <defName>Botania_StormBloomStudy</defName>
    <label>storm bloom</label>
    <description>A flower that salvages shorted-out power. Unlocks the storm bloom, which catches a conduit discharge as mana; its own buffer is small.</description>
    <baseCost>900</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_FuncAdvanced</li>
    </prerequisites>
    <researchViewX>4.60</researchViewX>
    <researchViewY>4.20</researchViewY>
  </ResearchProjectDef>

</Defs>
