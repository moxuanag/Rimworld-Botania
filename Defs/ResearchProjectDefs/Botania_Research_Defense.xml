<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       防御花段（2026-11-25 第十一次布局）：7 个节点，分类卡在 x=7.4。

       花之间横向 0.9（卡 7.4，花 8.3 与 9.2）；同档两行花纵向 0.6（2.8/3.4 与 5.6/6.2）；
       基础末行到进阶 0.8（3.4 到 4.2），进阶到终阶 1.4（4.2 到 5.6）；
       分类卡在它那两行花正中（+0.3）。

         y=3.1  x=x=7.4    Botania_DefenseFlowers   基础防御花（分类卡）
         y=2.8  x=x=8.3  Botania_ThornFlowerStudy 荆棘花
         y=2.8  x=x=9.2  Botania_DefenseI         荆棘钟花 thornbell
         y=4.5  x=x=7.4    Botania_DefAdvanced      进阶防御花（分类卡）
         y=4.2  x=x=8.3  Botania_DefenseII        爆萼花 blastcalyx
         y=5.9  x=x=7.4    Botania_DefAncient       远古防御花（分类卡）
         y=5.6  x=x=8.3  Botania_DefenseIII       远古陨击花 ancient starfall bloom

       前置结构（树上的可见线）：
         DefenseFlowers <- Garden
         ThornFlowerStudy / DefenseI <- DefenseFlowers
         DefAdvanced    <- DefenseFlowers（隐藏 Terrasteel）
         DefenseII      <- DefAdvanced
         DefAncient     <- DefAdvanced（隐藏 Gaia）
         DefenseIII     <- DefAncient

       数值全部取自 Buildings_Botania_TurretFlowers.xml、
       Weapons_Botania_TurretFlowers.xml 与 Source/Framework/ManaTurretCore.cs。
       ============================================================ -->

  <!-- ===== x=7.4 y=3.1 基础防御花：近距拦截的荆棘钟花 ===== -->

  <ResearchProjectDef>
    <defName>Botania_DefenseFlowers</defName>
    <label>basic defense flowers</label>
    <description>Defense flowers fight for the colony. This card attaches no defs itself; it opens the thorn flower and thornbell cards.</description>
    <baseCost>600</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Garden</li>
    </prerequisites>
    <researchViewX>7.40</researchViewX>
    <researchViewY>3.10</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=7.4 y=4.5 进阶防御花总览：把近防线换成射程 ===== -->

  <ResearchProjectDef>
    <defName>Botania_DefAdvanced</defName>
    <label>advanced defense flowers</label>
    <description>The advanced tier of defense flowers. This card attaches no defs itself; it opens the blastcalyx and ancient defense flowers cards.</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_DefenseFlowers</li>
    </prerequisites>
    <hiddenPrerequisites>
      <li>Botania_Terrasteel</li>
    </hiddenPrerequisites>
    <researchViewX>7.40</researchViewX>
    <researchViewY>4.50</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 荆棘花：半径 10，90 tick 一次脉冲；减速免费，伤害每目标 1 点 / 2 魔力（x=8.3, y=2.8） ===== -->

  <ResearchProjectDef>
    <defName>Botania_ThornFlowerStudy</defName>
    <label>thorn flower</label>
    <description>A flower that entangles what comes close and then cuts it. Unlocks the thorn flower; the slow is free and only the cutting is billed to the network.</description>
    <baseCost>1000</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_DefenseFlowers</li>
    </prerequisites>
    <researchViewX>8.30</researchViewX>
    <researchViewY>2.80</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 荆棘钟花：1x1 连发，30 格射程，每轮 5 发 ×12 伤害，15 魔力/轮（x=9.2, y=2.8） ===== -->

  <ResearchProjectDef>
    <defName>Botania_DefenseI</defName>
    <label>thornbell</label>
    <description>A compact burst turret grown as a flower. Unlocks the thornbell, which fires needles at hostiles in line of sight and spends mana instead of ammunition.</description>
    <baseCost>1500</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_DefenseFlowers</li>
    </prerequisites>
    <researchViewX>9.20</researchViewX>
    <researchViewY>2.80</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=7.4 y=5.9 远古防御花总览：全图射程的攻城花 ===== -->

  <ResearchProjectDef>
    <defName>Botania_DefAncient</defName>
    <label>ancient defense flowers</label>
    <description>The ancient tier of defense flowers. This card attaches no defs itself; it opens the ancient starfall bloom card.</description>
    <baseCost>1500</baseCost>
    <techLevel>Spacer</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_DefAdvanced</li>
    </prerequisites>
    <hiddenPrerequisites>
      <li>Botania_Gaia</li>
    </hiddenPrerequisites>
    <researchViewX>7.40</researchViewX>
    <researchViewY>5.90</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 爆萼花：2x2 越墙炮，70 格射程、10 格死区，80 魔力/发（x=8.3, y=4.2） ===== -->

  <ResearchProjectDef>
    <defName>Botania_DefenseII</defName>
    <label>blastcalyx</label>
    <description>A cannon flower that lobs a shell over walls without line of sight. Unlocks the blastcalyx, which cannot engage targets under thick mountain roof.</description>
    <baseCost>2500</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_DefAdvanced</li>
    </prerequisites>
    <researchViewX>8.30</researchViewX>
    <researchViewY>4.20</researchViewY>
  </ResearchProjectDef>

  <!-- ===== 远古陨击花：5x5 攻城，500 格全图、20 格死区，275 伤害，400 魔力/发（x=8.3, y=5.6） ===== -->

  <ResearchProjectDef>
    <defName>Botania_DefenseIII</defName>
    <label>ancient starfall bloom</label>
    <description>A siege flower whose meteor reaches across the map. Unlocks the ancient starfall bloom, which ignores walls and line of sight and must stand in the open.</description>
    <baseCost>4000</baseCost>
    <techLevel>Ultra</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_DefAncient</li>
    </prerequisites>
    <researchViewX>8.30</researchViewX>
    <researchViewY>5.60</researchViewY>
  </ResearchProjectDef>

</Defs>
