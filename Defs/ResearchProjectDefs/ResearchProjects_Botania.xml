<?xml version="1.0" encoding="utf-8" ?>

<!-- ============================================================
     植物魔法研究树（2026-11-25 第十一次布局：主线 1.5、花块 0.9、魔导 2x2 下移）。

     坐标：本引擎的研究树坐标就是 ResearchProjectDef 的
     researchViewX / researchViewY（Verse.ResearchProjectDef 的 x/y，
     MainTabWindow_Research 直接读它画节点），没有 layout 节点。

       间隔规格：
         主线横向间距 1.5（x = 0 / 1.5 / 3 / 4.5 / 6 / 7.5 / 9），主线在 y=2.0。
         三块花之间横向 0.9：产能 0 / 0.9 / 1.8（卡 0）、功能 3.7 / 4.6 / 5.5（卡 3.7）、
           防御 7.4 / 8.3 / 9.2（卡 7.4）；块与块的间隔统一 1.9（上一块末花到下一块分类卡），
           三块之间不做逐列对齐。
         同档两行花纵向间距 0.6（基础 2.8 与 3.4，终阶 5.6 与 6.2）。
         相邻档之间的行距：基础末行到进阶 0.8（3.4 到 4.2），进阶到终阶 1.4（4.2 到 5.6）。
         分类卡落在它那两行花的正中（行的 y 加 0.3，即 +0.3）：
           基础层 3.1   进阶层 4.5   终极 / 远古层 5.9。
         魔导 2x2 排在主线之上：(3,0.8) 与 (3.9,0.8) 一行，(3,1.4) 与 (3.9,1.4) 一行；
           两列间距 0.9、两行间距 0.6；魔力应用 (3,1.4) 与魔力钢 (3,2) 同列，
           竖向相距 0.6。
       坐标不得重复、不得为负，同 tab（Botania）内 ConfigErrors 会拒绝。

     跨支线门槛：6 条「泰拉钢 / 盖亚」前置在 hiddenPrerequisites。
       树上不画这些线（MainTabWindow_Research 只遍历 prerequisites），
       门槛照旧生效（ResearchProjectDef.PrerequisitesCompleted 两者同查），
       右侧详情面板仍会把它们列出来。可见前置边 33 条 + 隐藏 6 条 = 39 条。

     本文件 = 魔导 4 项 + 主线 7 项（共 11 项）：
       魔导 (3,0.8) 法杖改型 (3.9,0.8) 法力修补 (3,1.4) 魔力应用 (3.9,1.4) 法力家具
       主线 (0,2) 神秘花卉 (1.5,2) 花圃工艺 (3,2) 魔力钢 (4.5,2) 魔力栅格
            (6,2) 精灵工艺 (7.5,2) 泰拉钢 (9,2) 盖亚

     其余三段：
       Botania_Research_Generating.xml  产能 10 项（分类卡 x=0）
       Botania_Research_Functional.xml  功能  6 项（分类卡 x=3.7）
       Botania_Research_Defense.xml     防御  7 项（分类卡 x=7.4）
     ============================================================ -->

<Defs>

  <!-- ===== x=0 根：神秘花卉 ===== -->

  <ResearchProjectDef>
    <defName>Botania_Flowers</defName>
    <label>mystic botany</label>
    <description>Learn the wild mystic flowers and how to plant them again. Unlocks the cultivated white mystic flower.</description>
    <baseCost>300</baseCost>
    <techLevel>Neolithic</techLevel>
    <tab>Botania</tab>
    <researchViewX>0.00</researchViewX>
    <researchViewY>2.00</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=1 花圃工艺（花药台 / 花瓣染色 / 森林法杖） ===== -->

  <ResearchProjectDef>
    <defName>Botania_Garden</defName>
    <label>garden craft</label>
    <description>Establish the basis of flower craft. Unlocks the petal apothecary, the simple mana pool, the pure daisy and the wand of the forest, plus recipes for grinding mana powder and dyeing petals.</description>
    <baseCost>600</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Flowers</li>
    </prerequisites>
    <researchViewX>1.50</researchViewX>
    <researchViewY>2.00</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=2 魔力线起点：魔力钢（产能块根在 (3, 2)） ===== -->

  <ResearchProjectDef>
    <defName>Botania_Manasteel</defName>
    <label>manasteel</label>
    <description>Fold mana dust into steel. Unlocks the recipe for forging manasteel, the frame of every advanced mana structure.</description>
    <baseCost>1500</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Garden</li>
    </prerequisites>
    <researchViewX>3.00</researchViewX>
    <researchViewY>2.00</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=3 魔力栅格：池子与继电塔组成的「一张网」 ===== -->

  <ResearchProjectDef>
    <defName>Botania_ManaStorage</defName>
    <label>mana grid</label>
    <description>Gather scattered mana into a reserve. Unlocks the mana pool and the mana relay tower, which chains a pool's supply range outward.</description>
    <baseCost>2000</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Manasteel</li>
    </prerequisites>
    <researchViewX>4.50</researchViewX>
    <researchViewY>2.00</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=3 y=1.4 魔力应用：把网里的魔力接到固定点、换成别的东西 ===== -->

  <ResearchProjectDef>
    <defName>Botania_ManaGrid</defName>
    <label>mana application</label>
    <description>Put mana to work on ordinary powered machines. Unlocks the mana fluxfield, which draws on the mana network covering its own tile and turns it into electric power.</description>
    <baseCost>1200</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Manasteel</li>
    </prerequisites>
    <researchViewX>3.00</researchViewX>
    <researchViewY>1.40</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=3.9 y=1.4 法力家具：法力灯这类「用魔力发光的家具」 ===== -->

  <ResearchProjectDef>
    <defName>Botania_ManaLampStudy</defName>
    <label>mana furniture</label>
    <description>Furniture that lights with mana instead of power. Unlocks the mana lamp, which needs no conduit or fuel, goes dark when the supply runs dry and relights when mana returns.</description>
    <baseCost>800</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Manasteel</li>
    </prerequisites>
    <researchViewX>3.90</researchViewX>
    <researchViewY>1.40</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=3.9 y=0.8 法力修补：建筑恢复器与装备修复器共用的修补机制 ===== -->

  <ResearchProjectDef>
    <defName>Botania_Mending</defName>
    <label>mana repairer</label>
    <description>Mend with mana instead of parts. Unlocks the structure repairer and the item repairer, which restore built structures and worn gear.</description>
    <baseCost>1400</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Manasteel</li>
    </prerequisites>
    <researchViewX>3.90</researchViewX>
    <researchViewY>0.80</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=3 y=0.8 法杖改型：森林法杖的狙击型 / 爆破型 ===== -->

  <ResearchProjectDef>
    <defName>Botania_WandForms</defName>
    <label>wands</label>
    <description>Reforge the wand of the forest into specialised forms. Unlocks the sniper and blast wands; neither keeps the wand's plant magic.</description>
    <baseCost>2000</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Manasteel</li>
    </prerequisites>
    <researchViewX>3.00</researchViewX>
    <researchViewY>0.80</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=4 精灵工艺：精灵门换梦木 / 精灵石英 / 精灵之尘 / 元素锭 ===== -->

  <ResearchProjectDef>
    <defName>Botania_Infusion</defName>
    <label>elven</label>
    <description>Trade through an elven gate for the tier above manasteel. Unlocks the gate lintel and both pillars, plus the elementium sword, armour and helmet.</description>
    <baseCost>3000</baseCost>
    <techLevel>Spacer</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_ManaStorage</li>
    </prerequisites>
    <researchViewX>6.00</researchViewX>
    <researchViewY>2.00</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=5 泰拉钢：魔力线主干终点（也是三支花线进阶段的共同前置） ===== -->

  <ResearchProjectDef>
    <defName>Botania_Terrasteel</defName>
    <label>terrasteel</label>
    <description>Draw growing metal through a ring of pedestals. Unlocks the terrasteel altar and the pedestals, plus the terra blade, terrasteel armour and helmet.</description>
    <baseCost>4000</baseCost>
    <techLevel>Spacer</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Infusion</li>
    </prerequisites>
    <researchViewX>7.50</researchViewX>
    <researchViewY>2.00</researchViewY>
  </ResearchProjectDef>

  <!-- ===== x=6 盖亚：全树终点 ===== -->

  <ResearchProjectDef>
    <defName>Botania_Gaia</defName>
    <label>gaia</label>
    <description>What the gaia spirit teaches. It takes a techprint as well as research points. Unlocks the world seed nursery, gaia armour and the gaia helmet.</description>
    <baseCost>5000</baseCost>
    <techLevel>Ultra</techLevel>
    <tab>Botania</tab>
    <prerequisites>
      <li>Botania_Terrasteel</li>
    </prerequisites>
    <researchViewX>9.00</researchViewX>
    <researchViewY>2.00</researchViewY>
    <!-- 需要 1 张「盖亚之魂蓝图」（Botania_GaiaSpirit）。
         引擎的成对校验（ResearchProjectDef.ConfigErrors）：
           techprintCount > 0 但 heldByFactionCategoryTags 为空
             -> "requires techprints but has no heldByFactionCategoryTags."
           techprintCount == 0 但写了 tags
             -> "requires no techprints but has heldByFactionCategoryTags."
         所以两个字段只能成对加减。
         tags 的取值在本引擎里只是字符串（没有 FactionCategoryDef 类型，也不参与
         任何解析），这里写 BotaniaGaiaBoss 表示「由盖亚守护者掉落」，
         不与任何派系的 categoryTag 撞上，等于宣告商人不会出售。
         来源定案见 docs/植物魔法开发文档.md 第一部分 §11（2026-10-23 由遗迹改为 Boss 掉落）。 -->
    <techprintCount>1</techprintCount>
    <heldByFactionCategoryTags>
      <li>BotaniaGaiaBoss</li>
    </heldByFactionCategoryTags>
  </ResearchProjectDef>

</Defs>
