<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    盖亚专用思考树：只做三件事
      1. 受伤/着火/倒地的紧急响应（复用原版子树）
      2. 有敌对目标 -> 走近，到了站定
      3. 没有目标 -> 原地待命（不游荡）
    这样就不会再和 Pawn.Tick 里的技能逻辑抢 pather 控制权。
  -->
  <ThinkTreeDef>
    <defName>Botania_Gaia</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>BurningResponse</treeDef>
        </li>
        <li Class="ThinkNode_QueuedJob" />
        <li Class="Botania.JobGiver_GaiaCombat" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>


  <!-- 盖亚造物：只做「冲上去近战」，没有游荡行为 -->
  <ThinkTreeDef>
    <defName>Botania_GaiaSpawnling</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>BurningResponse</treeDef>
        </li>
        <li Class="ThinkNode_QueuedJob" />
        <li Class="Botania.JobGiver_GaiaSpawnlingCombat" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>


  <!--
    常量思考树：盖亚系单位（Boss / 造物）共用。
    原版 AnimalConstant 里有 JobGiver_AnimalFlee —— 会「逃离敌人」，
    表现就是明明没有目标也在 Boss 身边来回乱跑。这里只保留最基本的响应。
  -->
  <ThinkTreeDef>
    <defName>Botania_GaiaConstant</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>MentalStateCritical</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>BurningResponse</treeDef>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

</Defs>
